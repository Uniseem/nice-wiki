{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.com/nice-wiki/libs/platform/types",
  "$defs": {
    "SigningKey": {
      "type": "object",
      "additionalProperties": false,
      "description": "私钥引用；私钥字节只在内存",
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "密钥ID"
        },
        "privateKeyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "secret文件路径引用"
        }
      },
      "required": [
        "keyId",
        "privateKeyRef"
      ]
    },
    "AssertionClaims": {
      "type": "object",
      "additionalProperties": false,
      "description": "服务断言声明",
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "调用服务slug"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "目标服务slug"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "HTTP方法"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "请求路径"
        },
        "bodyHash": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Hash",
          "description": "请求体SHA-256"
        },
        "issuedAt": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Timestamp",
          "description": "签发时刻"
        },
        "expiresAt": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Timestamp",
          "description": "≤签发后60秒"
        },
        "jti": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "一次性ID"
        },
        "loginNetworkScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "../../../contracts/common.schema.json#/$defs/Hash"
          },
          "description": "只允许portal→identity断言携带受信peer派生网络HMAC，当前/前一日跨窗口，不取浏览器字段"
        },
        "siteId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "服务签名的站点作用域；只取可信op.Actor.SiteID，省略兼容旧system主体，不从浏览器头取"
        },
        "networkBudgetScopes": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "../../../contracts/common.schema.json#/$defs/Hash"
          },
          "description": "portal到traffic-guard的已签名网络预算范围"
        }
      },
      "required": [
        "issuer",
        "audience",
        "method",
        "path",
        "bodyHash",
        "issuedAt",
        "expiresAt",
        "jti"
      ]
    },
    "AssertionExpectation": {
      "type": "object",
      "additionalProperties": false,
      "description": "验证断言时的期望值",
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "本服务slug"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "HTTP方法"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "请求路径"
        },
        "bodyHash": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Hash",
          "description": "请求体SHA-256"
        }
      },
      "required": [
        "audience",
        "method",
        "path",
        "bodyHash"
      ]
    },
    "TrustAnchors": {
      "type": "object",
      "additionalProperties": false,
      "description": "服务公钥表",
      "properties": {
        "services": {
          "type": "array",
          "maxItems": 64,
          "description": "每服务公钥",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "description": "一个公钥",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "description": "服务slug"
              },
              "keyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "description": "密钥ID"
              },
              "publicKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "description": "Ed25519公钥base64url"
              }
            },
            "required": [
              "slug",
              "keyId",
              "publicKey"
            ]
          }
        },
        "portalDelegationKeys": {
          "type": "array",
          "maxItems": 4,
          "description": "portal委托公钥",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "description": "一个公钥",
            "properties": {
              "keyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "description": "密钥ID"
              },
              "publicKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "description": "Ed25519公钥base64url"
              }
            },
            "required": [
              "keyId",
              "publicKey"
            ]
          }
        }
      },
      "required": [
        "services",
        "portalDelegationKeys"
      ]
    },
    "DelegationClaims": {
      "type": "object",
      "additionalProperties": false,
      "description": "用户委托声明",
      "properties": {
        "actor": {
          "$ref": "../../../contracts/common.schema.json#/$defs/AuthContext",
          "description": "委托主体"
        },
        "sessionVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "会话版本"
        },
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "路由ID"
        },
        "bodyHash": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Hash",
          "description": "请求体SHA-256"
        },
        "expiresAt": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Timestamp",
          "description": "≤签发后10秒"
        }
      },
      "required": [
        "actor",
        "sessionVersion",
        "route",
        "bodyHash",
        "expiresAt"
      ]
    },
    "DelegationExpectation": {
      "type": "object",
      "additionalProperties": false,
      "description": "验证委托时的期望值",
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "portal入口填期望路由ID；下游链路原样转发时留空表示不核对路由"
        },
        "bodyHash": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Hash",
          "description": "本跳请求体SHA-256；portal首跳必须等于proof原文，其他已认证服务跳的正文由本跳服务断言校验"
        },
        "callerService": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "已成功验签的服务断言issuer，禁止使用未经认证请求字段。portal首跳绑定原bodyHash；其他服务后续跳由各自断言绑定当前正文并原样保留原用户proof。"
        }
      },
      "required": [
        "callerService",
        "bodyHash"
      ]
    },
    "RuntimeView": {
      "type": "object",
      "additionalProperties": false,
      "description": "运行状态摘要",
      "properties": {
        "dataEpoch": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "当前active epoch"
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "site-config RuntimePhase"
        },
        "restoreId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "可选；恢复ID"
        },
        "targetDataEpoch": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "可选；目标epoch"
        },
        "maintenance": {
          "type": "boolean",
          "description": "是否维护中"
        },
        "revision": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Revision",
          "description": "site-config control.db真实CAS水位，不以时间或0代替"
        },
        "barrierId": {
          "type": "string",
          "description": "当前运行控制屏障，缺省空"
        }
      },
      "required": [
        "dataEpoch",
        "phase",
        "maintenance"
      ]
    },
    "Tx": {
      "type": "object",
      "x-internal": true,
      "description": "本域数据库事务句柄（Go接口，不序列化）"
    },
    "OutboxStore": {
      "type": "object",
      "x-internal": true,
      "description": "本域outbox表访问接口"
    },
    "JobsClient": {
      "type": "object",
      "x-internal": true,
      "description": "jobs版本化客户端，自动服务断言；CheckLease/CompleteJob/FailJob都携带workerId与fence，终局保留paidResultRefs，Complete可不带结果对象。"
    },
    "GatewayClient": {
      "type": "object",
      "x-internal": true,
      "description": "由model-gateway openapi生成的客户端"
    },
    "SiteConfigClient": {
      "type": "object",
      "x-internal": true,
      "description": "由site-config openapi生成的客户端"
    },
    "EventHandlerRegistry": {
      "type": "object",
      "x-internal": true,
      "description": "事件名→处理函数映射，由本域events.json生成"
    },
    "JobExecutorRegistry": {
      "type": "object",
      "x-internal": true,
      "description": "jobType→执行函数映射，由本域jobTypes生成"
    },
    "ServiceSpec": {
      "type": "object",
      "x-internal": true,
      "description": "本域slug与BuildApplication/Serve/Shutdown回调"
    },
    "RelayConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "转发循环参数",
      "properties": {
        "batchLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "单批行数"
        },
        "pollMillis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "description": "空闲轮询间隔"
        },
        "runtime": {
          "x-internal": true,
          "description": "必需当前RuntimeView回调；未知不得按running处理"
        },
        "writeWindow": {
          "x-internal": true,
          "description": "必需Go函数(context.Context)(time.Time,error)，返回本域control屏障截止；正常运行无屏障为零时间，未知/关闭直接报错"
        }
      },
      "required": [
        "batchLimit",
        "pollMillis",
        "writeWindow",
        "runtime"
      ]
    },
    "ConsumerConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "订阅循环参数",
      "properties": {
        "consumerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "本域slug"
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "事件名@版本"
          },
          "description": "订阅的事件"
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "并发上限"
        },
        "runtime": {
          "x-internal": true,
          "description": "Go函数，不序列化；读取当前RuntimeView，用于旧代跳过与屏障暂停"
        },
        "validatePayload": {
          "x-internal": true,
          "description": "Go函数，不序列化；按生产方payloadSchema校验载荷，返回错误即不确认"
        },
        "siteId": {
          "x-internal": true,
          "description": "可信本域站点，空值仅system控制命名空间"
        }
      },
      "required": [
        "consumerId",
        "events",
        "maxInFlight",
        "runtime",
        "validatePayload"
      ]
    },
    "WorkerConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "领取循环参数",
      "properties": {
        "jobTypes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "任务类型"
          },
          "description": "本域登记类型"
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "并发上限"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "本域slug，作为jobs领取owner"
        },
        "runtime": {
          "x-internal": true,
          "description": "Go可信运行权威回调，不序列化；缺失或读取失败暂停领取，不能将未知状态当允许"
        },
        "operationContext": {
          "x-internal": true,
          "description": "Go可信回调(context.Context, ClaimedJob) (OperationContext,error)，从本域持久任务读取获准主体、预算与期限，不从任务ID猜测授权"
        },
        "onLeaseRenewed": {
          "x-internal": true,
          "description": "可选本域真实租约镜像CAS回调；初次start后及每次权威续约后调用，失败停止执行，不再调CheckLease或伪造心跳"
        },
        "onCancellationObserved": {
          "x-internal": true,
          "description": "可选Go可信回调(context.Context, OperationContext, ClaimedJob) error；仅真实HeartbeatJob.cancelRequested时在取消执行前调用一次，绑定原worker/fence/epoch持久取消事实，不重查租约、不写业务结果或触发模型；safePoint不调用。"
        }
      },
      "required": [
        "owner",
        "jobTypes",
        "maxConcurrency",
        "operationContext",
        "runtime"
      ]
    },
    "InvokeModelRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型调用请求",
      "properties": {
        "request": {
          "$ref": "../../../modules/model-gateway/contracts/types.json#/$defs/CreateInvocationInput",
          "description": "网关请求"
        },
        "idempotencyKey": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "操作ID+步骤名"
        },
        "stream": {
          "type": "boolean",
          "description": "是否逐条回调"
        },
        "onEvent": {
          "x-internal": true,
          "description": "Go流式回调，不序列化；非nil时每收到一条StreamEvent调用一次，返回错误即中止"
        }
      },
      "required": [
        "request",
        "idempotencyKey",
        "stream"
      ]
    },
    "InvokeModelOutcome": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型调用终态",
      "properties": {
        "invocationId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "网关调用ID"
        },
        "state": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "charge_unknown"
          ],
          "description": "终态"
        },
        "events": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "../../../modules/model-gateway/contracts/types.json#/$defs/StreamEvent"
          },
          "description": "全部事件"
        }
      },
      "required": [
        "invocationId",
        "state",
        "events"
      ]
    },
    "ServiceConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "通用服务配置",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "服务slug"
        },
        "listen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "监听地址"
        },
        "dataRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "数据根"
        },
        "trustAnchorRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "公钥表路径"
        },
        "signingKeyRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "本服务私钥路径"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          },
          "description": "依赖服务slug→内部URL"
        },
        "publicBaseURL": {
          "type": "string",
          "maxLength": 2048,
          "description": "部署提供的可信公共地址；不从请求Host推导，需要初始化或来源校验的用例再要求非空"
        },
        "allowLocalHTTP": {
          "type": "boolean",
          "default": false,
          "description": "显式允许loopback地址的HTTP本地开发，其余公共地址必须HTTPS"
        },
        "delegationKeyRef": {
          "type": "string",
          "description": "portal专用用户委托SigningKey JSON引用，必须来自portalDelegationKeys；非portal服务可省略，不能回退服务断言密钥"
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "default": [],
          "description": "部署明确声明的规范代理IP网段；空列表完全忽略转发地址；从真实连接向左跳过受信代理，不信任浏览器指定的地址"
        },
        "masterKeyRef": {
          "type": "string",
          "maxLength": 2048,
          "description": "可选部署主密钥绝对路径引用；由需要加密的域按用例读取，公共配置加载不读取密钥；省略或空值不影响无密钥的免费读取"
        },
        "allowedGitHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "maxItems": 64,
          "description": "仅data-protection使用的可信Git主机allowlist，默认空拒远程；禁止由请求或Dependencies推导"
        }
      },
      "required": [
        "module",
        "listen",
        "dataRoot",
        "trustAnchorRef",
        "signingKeyRef",
        "dependencies"
      ]
    },
    "SwapResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "换目录结果",
      "properties": {
        "action": {
          "enum": [
            "none",
            "switched",
            "rolled-back"
          ],
          "description": "执行的动作"
        },
        "restoreId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
          "description": "可选；恢复ID"
        }
      },
      "required": [
        "action"
      ]
    },
    "OpenAPIDocument": {
      "type": "object",
      "description": "kin-openapi *openapi3.T：本域生成代码 gen.GetSwagger() 返回的内嵌规格，仅进程内使用",
      "x-internal": true
    },
    "HTTPMiddleware": {
      "type": "object",
      "description": "func(http.Handler) http.Handler 入口中间件，仅进程内使用",
      "x-internal": true
    },
    "SessionAccessClaims": {
      "type": "object",
      "additionalProperties": false,
      "description": "固定identity发行、portal使用的NW-SESSION会话访问令牌声明；版本与撤销由identity权威核对",
      "properties": {
        "sid": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "sub": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "siteId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "authEpoch": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "dataEpoch": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "jti": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        },
        "credentialRevision": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Revision"
        },
        "permissionRevision": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Revision"
        },
        "sessionRevision": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Revision"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "description": "iat UNIX秒"
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "description": "exp UNIX秒，iat之后且不超过900秒"
        },
        "iss": {
          "const": "identity"
        },
        "aud": {
          "const": "portal"
        }
      },
      "required": [
        "sid",
        "sub",
        "siteId",
        "authEpoch",
        "dataEpoch",
        "jti",
        "credentialRevision",
        "permissionRevision",
        "sessionRevision",
        "iat",
        "exp",
        "iss",
        "aud"
      ]
    },
    "SessionSecrets": {
      "type": "object",
      "additionalProperties": false,
      "x-internal": true,
      "description": "独立32字节CSPRNG秘密；只返回内存cookie适配器，业务仅存摘要",
      "properties": {
        "accessNonce": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
