{
  "moduleId": "L01",
  "module": "platform",
  "version": 1,
  "phase": "design",
  "requirements": [
    {
      "id": "L01-R01",
      "description": "服务间身份与用户委托的签发和验证只在本库实现一次",
      "acceptance": "各服务不自写签名或验签逻辑"
    },
    {
      "id": "L01-R02",
      "description": "outbox、inbox、事件订阅、任务领取、模型调用、恢复换目录与进程模板的通用实现",
      "acceptance": "各服务对应约束函数只装配本域参数并调用本库"
    },
    {
      "id": "L01-R03",
      "description": "本库不含任何业务规则、不访问任何服务的私有数据、不导入服务代码",
      "acceptance": "依赖只有标准库、已登记第三方库与生成客户端"
    }
  ],
  "dependencies": [
    {
      "module": "jobs",
      "mode": "sync",
      "purpose": "事件与任务接口",
      "failurePolicy": "退避重试，不丢outbox"
    },
    {
      "module": "model-gateway",
      "mode": "sync",
      "purpose": "模型调用",
      "failurePolicy": "按网关Problem返回"
    },
    {
      "module": "site-config",
      "mode": "sync",
      "purpose": "运行状态",
      "failurePolicy": "失联时写请求关闭"
    }
  ],
  "files": [
    {
      "path": "libs/platform/serviceauth/assertion.go",
      "kind": "handwritten",
      "purpose": "服务断言签发与验证"
    },
    {
      "path": "libs/platform/serviceauth/delegation.go",
      "kind": "handwritten",
      "purpose": "服务签名、用户委托验证、恢复激活回执与作用域绑定的分页游标签名"
    },
    {
      "path": "libs/platform/opctx/context.go",
      "kind": "handwritten",
      "purpose": "可信OperationContext构建"
    },
    {
      "path": "libs/platform/problem/problem.go",
      "kind": "handwritten",
      "purpose": "公共Problem输出"
    },
    {
      "path": "libs/platform/outbox/outbox.go",
      "kind": "handwritten",
      "purpose": "事务内outbox登记"
    },
    {
      "path": "libs/platform/outbox/relay.go",
      "kind": "handwritten",
      "purpose": "outbox转发循环"
    },
    {
      "path": "libs/platform/inbox/inbox.go",
      "kind": "handwritten",
      "purpose": "事件inbox去重"
    },
    {
      "path": "libs/platform/inbox/consumer.go",
      "kind": "handwritten",
      "purpose": "事件订阅循环"
    },
    {
      "path": "libs/platform/worker/loop.go",
      "kind": "handwritten",
      "purpose": "任务领取循环"
    },
    {
      "path": "libs/platform/modelclient/invoke.go",
      "kind": "handwritten",
      "purpose": "模型调用助手"
    },
    {
      "path": "libs/platform/lifecycle/config.go",
      "kind": "handwritten",
      "purpose": "服务配置加载"
    },
    {
      "path": "libs/platform/lifecycle/runtime.go",
      "kind": "handwritten",
      "purpose": "运行状态读取与监视"
    },
    {
      "path": "libs/platform/apivalidate/validator.go",
      "kind": "handwritten",
      "purpose": "HTTP入口统一请求校验中间件（kin-openapi openapi3filter）"
    },
    {
      "path": "libs/platform/lifecycle/service.go",
      "kind": "handwritten",
      "purpose": "进程模板"
    },
    {
      "path": "libs/platform/cmd/nw-keys/main.go",
      "kind": "handwritten",
      "purpose": "服务密钥生成工具"
    },
    {
      "path": "libs/platform/platform.go",
      "kind": "handwritten",
      "purpose": "公共契约类型、接口和确定性纯工具，禁止业务规则"
    },
    {
      "path": "libs/platform/go.mod",
      "kind": "config",
      "purpose": "Go module nice-wiki/libs/platform；只依赖标准库与ADR0005登记的第三方库；各服务以相对replace引用"
    },
    {
      "path": "libs/platform/go.sum",
      "kind": "generated",
      "purpose": "依赖校验锁；由go mod download生成"
    },
    {
      "path": "libs/platform/worker/client.go",
      "kind": "handwritten",
      "purpose": "生成jobs HTTP端口到公共任务租约机制的一次性生产方schema适配"
    },
    {
      "path": "libs/platform/modelclient/client.go",
      "kind": "handwritten",
      "purpose": "真实生成网关HTTP端口到公共模型调用机制的单一严格适配"
    },
    {
      "path": "libs/platform/serviceauth/admission.go",
      "kind": "handwritten",
      "purpose": "统一风控凭证签名机制"
    },
    {
      "path": "libs/platform/inbox/client.go",
      "kind": "handwritten",
      "purpose": "真实事件订阅HTTP窄适配、失败关闭与准确累计统计"
    },
    {
      "path": "libs/platform/lifecycle/task_group.go",
      "kind": "handwritten",
      "purpose": "受监督本进程任务去重、并发、原截止与关闭排空"
    },
    {
      "path": "libs/platform/lifecycle/parser_process.go",
      "kind": "handwritten",
      "purpose": "受控有界子进程解析，不继承配置密钥或业务句柄"
    },
    {
      "path": "libs/platform/lifecycle/parser_sandbox_linux_amd64.go",
      "kind": "handwritten",
      "purpose": "Linux amd64封闭系统调用允许集与硬资源限制"
    },
    {
      "path": "libs/platform/lifecycle/parser_sandbox_other.go",
      "kind": "handwritten",
      "purpose": "其他平台相同入口失败关闭，不降级非隔离PDF"
    },
    {
      "path": "libs/platform/web/module-api.ts",
      "kind": "handwritten",
      "purpose": "浏览器非序列化模块API端口与bootstrap类型，不暴露HttpOnly秘密"
    },
    {
      "path": "libs/platform/lifecycle/identity.go",
      "kind": "handwritten",
      "purpose": "各域启动服务身份描述与本站签名公钥匹配共用边界"
    },
    {
      "path": "libs/platform/lifecycle/task_secret.go",
      "kind": "handwritten",
      "purpose": "通用有界异步任务秘密加密，不含业务授权与持久策略"
    }
  ],
  "jobTypes": [],
  "backgroundTasks": [],
  "consumes": {
    "identity": [
      "checkAuthorization"
    ],
    "jobs": [
      "acknowledgeEvent",
      "checkLease",
      "claimJob",
      "completeJob",
      "failJob",
      "heartbeatJob",
      "publishEvent",
      "startJob",
      "subscribeEvents"
    ],
    "model-gateway": [
      "cancelInference",
      "createInference",
      "lookupInference",
      "readInference",
      "resumeInference"
    ],
    "site-config": [
      "readRuntimeState"
    ]
  }
}
