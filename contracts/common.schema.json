{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.com/nice-wiki/common/v1",
  "title": "公共数据契约",
  "type": "object",
  "$defs": {
    "Identifier": {
      "type": "string",
      "description": "系统生成的不透明 ID，不含个人信息",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "description": "对象单调修订号"
    },
    "Hash": {
      "type": "string",
      "description": "SHA-256 小写十六进制",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "RFC3339 UTC 时间",
      "format": "date-time"
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD",
          "description": "唯一支持USD"
        },
        "micros": {
          "type": "integer",
          "minimum": 0,
          "description": "百万分之一美元，整数，禁止浮点累计"
        }
      },
      "required": [
        "currency",
        "micros"
      ],
      "description": "美元整数微额，USD与micros；禁止浮点累计，0仅在明确额度配置中表示不限"
    },
    "CostClass": {
      "type": "string",
      "enum": [
        "qa",
        "background",
        "admin-probe"
      ],
      "description": "可信服务上下文决定，公开请求不能指定"
    },
    "AuthContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjectId": {
          "$ref": "#/$defs/Identifier",
          "description": "经验证的主体ID"
        },
        "kind": {
          "enum": [
            "admin",
            "visitor",
            "service"
          ],
          "description": "主体类别或状态类别，按枚举处理"
        },
        "siteId": {
          "$ref": "#/$defs/Identifier",
          "description": "单站身份，与授权上下文一致"
        },
        "sessionId": {
          "$ref": "#/$defs/Identifier",
          "description": "经验证会话ID，已撤销会话拒绝"
        },
        "permissionRevision": {
          "$ref": "#/$defs/Revision",
          "description": "权威权限版本；撤销变化必须同步验证"
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "string",
            "description": ""
          },
          "description": "明确技术权限集合，映射旧10项功能"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "凭证/租约到期UTC时刻；到期拒绝，不自动续命"
        },
        "sessionRevision": {
          "$ref": "#/$defs/Revision",
          "description": "identity当前会话单调版本；admin会话委托必须携带且大于0，撤销/轮换后旧版本拒绝"
        }
      },
      "required": [
        "subjectId",
        "kind",
        "siteId",
        "permissionRevision",
        "grants",
        "expiresAt"
      ],
      "description": "经identity验证的单站授权上下文；浏览器不能直接构造可信grants"
    },
    "Actor": {
      "$ref": "#/$defs/AuthContext"
    },
    "OperationContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/$defs/Identifier",
          "description": "本次请求唯一追踪ID"
        },
        "operationId": {
          "$ref": "#/$defs/Identifier",
          "description": "可恢复操作ID"
        },
        "rootOperationId": {
          "$ref": "#/$defs/Identifier",
          "description": "跨服务根操作ID，子调用不能更换以重置费用/重试上限"
        },
        "callerService": {
          "type": "string",
          "description": "经服务身份验证的调用模块"
        },
        "actor": {
          "$ref": "#/$defs/AuthContext",
          "description": "用户或服务委托主体"
        },
        "deadline": {
          "$ref": "#/$defs/Timestamp",
          "description": "全链路截止；与本地取消取较早值"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier",
          "description": "当前业务数据代次"
        },
        "costClass": {
          "$ref": "#/$defs/CostClass",
          "description": "可信费用归属类别"
        },
        "cancellationId": {
          "$ref": "#/$defs/Identifier",
          "description": "根操作的贯穿取消标识"
        }
      },
      "required": [
        "requestId",
        "operationId",
        "rootOperationId",
        "callerService",
        "actor",
        "deadline",
        "dataEpoch"
      ],
      "description": "服务间可信操作元数据；与身份、根操作、截止、取消和当前数据代次绑定",
      "x-go-internal-fields": {
        "loginNetworkScopes": "[]Hash，json:-；只从已验签portal服务断言获取，不采用浏览器正文或头"
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "VALIDATION",
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "NOT_FOUND",
        "GONE",
        "CONFLICT",
        "VERSION_MISMATCH",
        "LOCKED",
        "UNSUPPORTED_SCHEMA",
        "UNSUPPORTED_CAPABILITY",
        "RATE_LIMITED",
        "BUDGET_EXCEEDED",
        "CANCELLED",
        "DEADLINE_EXCEEDED",
        "DEPENDENCY_UNAVAILABLE",
        "STALE_RESULT",
        "INTEGRITY_ERROR",
        "INTERNAL",
        "CHALLENGE_REQUIRED",
        "INVOCATION_NOT_ACCEPTED"
      ],
      "description": "ErrorCode的公共协议类型；字段及范围按本schema"
    },
    "FieldIssue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "字段路径，不包含字段值"
        },
        "reason": {
          "type": "string",
          "description": "可展示且不泄露输入正文的原因"
        }
      },
      "required": [
        "field",
        "reason"
      ],
      "description": "FieldIssue的公共协议类型；字段及范围按本schema"
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "问题类型标识"
        },
        "title": {
          "type": "string",
          "description": "中文标题"
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "description": "HTTP 状态"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "登记的稳定错误码"
        },
        "detail": {
          "type": "string",
          "description": "中文安全说明"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier",
          "description": "本次请求唯一追踪ID"
        },
        "retryable": {
          "type": "boolean",
          "description": "是否允许在幂等和总截止内重试"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldIssue"
          },
          "description": "逐字段输入错误，不能回显秘密原值"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "requestId",
        "retryable"
      ],
      "description": "公共失败响应；不含秘密、问题正文、原始IP或内部堆栈"
    },
    "Error": {
      "$ref": "#/$defs/Problem"
    },
    "PageRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "分页返回上限"
        },
        "cursor": {
          "type": "string",
          "description": "签名不透明游标"
        }
      },
      "required": [],
      "description": "分页查询；最多100项，游标是签名不透明值，不把数据库offset当协议"
    },
    "PageInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nextCursor": {
          "type": "string",
          "description": "下一页签名游标，无下一页则省略"
        },
        "hasMore": {
          "type": "boolean",
          "description": "是否存在下一页"
        }
      },
      "required": [
        "hasMore"
      ],
      "description": "分页结果状态；没有下一页时nextCursor省略"
    },
    "PublishedRevisionRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "$ref": "#/$defs/Identifier",
          "description": "稳定文档ID"
        },
        "publishedRevisionId": {
          "$ref": "#/$defs/Identifier",
          "description": "不可变发布修订ID"
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "单调非负修订号"
        },
        "contentHash": {
          "$ref": "#/$defs/Hash",
          "description": "规范正文SHA256"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "内容格式正整数版本，变化必须迁移"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier",
          "description": "当前业务数据代次"
        }
      },
      "required": [
        "documentId",
        "publishedRevisionId",
        "revision",
        "contentHash",
        "schemaVersion",
        "dataEpoch"
      ],
      "description": "不可变发布修订引用；document/revision/contentHash/schema/dataEpoch共同验证"
    },
    "DocRef": {
      "$ref": "#/$defs/PublishedRevisionRef"
    },
    "BlockRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/PublishedRevisionRef",
          "description": "块所属不可变发布修订引用"
        },
        "blockId": {
          "$ref": "#/$defs/Identifier",
          "description": "文档内稳定唯一块ID"
        },
        "blockHash": {
          "$ref": "#/$defs/Hash",
          "description": "规范块内容SHA256"
        }
      },
      "required": [
        "document",
        "blockId",
        "blockHash"
      ],
      "description": "同一发布修订内的稳定块引用，附块内容哈希"
    },
    "PublicationValidation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/PublishedRevisionRef",
          "description": "需要权威校验的发布引用"
        },
        "visible": {
          "type": "boolean",
          "description": "当前允许公开读取"
        },
        "matchesCurrent": {
          "type": "boolean",
          "description": "引用是否为当前发布修订"
        },
        "currentRevision": {
          "$ref": "#/$defs/Revision",
          "description": "权威当前发布修订号"
        },
        "visibilityRevision": {
          "$ref": "#/$defs/Revision",
          "description": "发布/撤回可见性单调版本"
        }
      },
      "required": [
        "reference",
        "visible",
        "matchesCurrent",
        "currentRevision",
        "visibilityRevision"
      ],
      "description": "权威可见性门禁结果；visible与matchesCurrent都成立才交付对应缓存"
    },
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "description": "模块 slug"
        },
        "objectId": {
          "$ref": "#/$defs/Identifier",
          "description": "本域不可变对象ID"
        },
        "version": {
          "$ref": "#/$defs/Revision",
          "description": "对象或协议版本"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "完整字节内容SHA256"
        },
        "mediaType": {
          "type": "string",
          "description": "规范媒体类型，按允许集验证"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "description": "完整对象字节数，读取结束复核"
        }
      },
      "required": [
        "owner",
        "objectId",
        "version",
        "sha256",
        "mediaType",
        "byteSize"
      ],
      "description": "所属服务提供的不可变受控对象，按sha256与byteSize验证，不是任意磁盘路径"
    },
    "AssetRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "$ref": "#/$defs/Identifier",
          "description": "media资源稳定ID"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "完整字节内容SHA256"
        },
        "mediaType": {
          "type": "string",
          "description": "规范媒体类型，按允许集验证"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "description": "完整对象字节数，读取结束复核"
        }
      },
      "required": [
        "assetId",
        "sha256",
        "mediaType",
        "byteSize"
      ],
      "description": "资源身份、哈希、媒体类型与字节数；通过media受控读取"
    },
    "MemoryContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "description": "canonical AI任务ID"
        },
        "language": {
          "type": "string",
          "description": "规范语言标签"
        },
        "text": {
          "type": "string",
          "description": "不记录到日志的注入正文"
        },
        "versionHash": {
          "$ref": "#/$defs/Hash",
          "description": "规范版本内容SHA256"
        },
        "mappingRevision": {
          "$ref": "#/$defs/Revision",
          "description": "任务映射修订号"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 0,
          "description": "完整渲染注入text的UTF8字节数，包含条目说明与分隔，不含JSON元数据；空记忆为0"
        }
      },
      "required": [
        "taskId",
        "language",
        "text",
        "versionHash",
        "mappingRevision",
        "byteSize"
      ],
      "description": "单任务/语言组装后的记忆文本及版本，UTF8字节预算由memory负责"
    },
    "EmbeddingSpace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "$ref": "#/$defs/Hash",
          "description": "完整嵌入空间唯一ID"
        },
        "provider": {
          "type": "string",
          "description": "供应方稳定标识"
        },
        "modelVersion": {
          "type": "string",
          "description": "供应方模型版本，不只用展示名"
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "description": "向量维度正整数"
        },
        "preprocessingVersion": {
          "type": "string",
          "description": "规范预处理算法版本"
        }
      },
      "required": [
        "spaceId",
        "provider",
        "modelVersion",
        "dimensions",
        "preprocessingVersion"
      ],
      "description": "供应方、模型版本、维度与预处理版本共同定义空间；不同空间不得比相似度"
    },
    "AdmissionPermit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admissionId": {
          "$ref": "#/$defs/Identifier",
          "description": "准入记录稳定ID"
        },
        "requestId": {
          "$ref": "#/$defs/Identifier",
          "description": "原QA问题的稳定RootOperationID；不是当前RPC的追踪RequestID"
        },
        "subjectId": {
          "$ref": "#/$defs/Identifier",
          "description": "经验证的主体ID"
        },
        "action": {
          "type": "string",
          "description": "许可动作，必须与消费场景一致"
        },
        "token": {
          "type": "string",
          "description": "mint分配阶段为空串，不构成模型凭证；仅QA按原根持久消费后签发非空凭证，禁止记录"
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "凭证/租约到期UTC时刻；到期拒绝，不自动续命"
        },
        "sessionBudgetScope": {
          "$ref": "#/$defs/Identifier",
          "description": "guard签名的伪名会话费用作用域；所有本轮子调用必须继承，客户端不能自选"
        },
        "networkBudgetScope": {
          "$ref": "#/$defs/Identifier",
          "description": "guard签名的伪名网络费用作用域；IPv6按/64，原始IP不进入许可或账本"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier",
          "description": "当前数据代次；恢复换代后旧许可失效"
        },
        "audience": {
          "type": "string",
          "const": "model-gateway",
          "description": "费用许可仅由统一模型网关使用"
        }
      },
      "required": [
        "admissionId",
        "requestId",
        "subjectId",
        "action",
        "token",
        "expiresAt",
        "sessionBudgetScope",
        "networkBudgetScope",
        "dataEpoch",
        "audience"
      ],
      "description": "guard分配元数据；token空表示未消费。仅消费后的QA许可具有nw-admission-v1签名并可提交MG。签名覆盖全部字段，MG仍核原根/代次/QA动作；免费语言提示从不签模型token。"
    },
    "AcceptedJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "$ref": "#/$defs/Identifier",
          "description": "持久任务ID"
        },
        "operationId": {
          "$ref": "#/$defs/Identifier",
          "description": "可恢复操作ID"
        },
        "state": {
          "const": "queued",
          "description": "精确枚举状态，未知值拒绝"
        }
      },
      "required": [
        "jobId",
        "operationId",
        "state"
      ],
      "description": "已持久登记的异步任务引用，不代表任务执行成功"
    },
    "HealthStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "HealthStatus.module；按类型、枚举及required约束使用"
        },
        "version": {
          "type": "string",
          "description": "对象或协议版本"
        },
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable"
          ],
          "description": "HTTP状态码"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "description": ""
          },
          "description": "按配置已启用或缺失的业务能力"
        }
      },
      "required": [
        "module",
        "version",
        "status",
        "capabilities"
      ],
      "description": "服务版本、存活/就绪与能力状态，输出脱敏说明"
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Identifier",
          "description": "不可变事件唯一ID"
        },
        "eventType": {
          "type": "string",
          "description": "生产方登记事件名称"
        },
        "eventVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "EventEnvelope.eventVersion；按类型、枚举及required约束使用"
        },
        "producer": {
          "type": "string",
          "description": "事件唯一生产方"
        },
        "subjectId": {
          "$ref": "#/$defs/Identifier",
          "description": "经验证的主体ID"
        },
        "revision": {
          "$ref": "#/$defs/Revision",
          "description": "单调非负修订号"
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp",
          "description": "状态提交发生UTC时刻"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier",
          "description": "当前业务数据代次"
        },
        "siteId": {
          "$ref": "#/$defs/Identifier",
          "description": "事件发生的站点；多站点平台上消费者按它切换站点作用域，平台级事件省略"
        },
        "payload": {
          "type": "object",
          "description": "必须符合生产方 contracts/events.json 登记的载荷 schema"
        }
      },
      "required": [
        "eventId",
        "eventType",
        "eventVersion",
        "producer",
        "subjectId",
        "revision",
        "occurredAt",
        "dataEpoch",
        "payload"
      ],
      "description": "持久至少一次事件信封；按subject修订与eventId去重，禁止广播业务正文"
    },
    "RelayOutboxInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "本域outbox转发循环的单批参数；未标可选字段均必填",
      "properties": {
        "batchLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100,
          "description": "单批最多领取的已提交outbox行数"
        }
      },
      "required": [
        "batchLimit"
      ]
    },
    "RelayOutboxResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "单批转发结果；计数只描述本批，不代表全域已送达",
      "properties": {
        "relayed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "本批经jobs持久确认并标记relayed的行数"
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "本批结束后仍待转发的行数"
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "同eventId异hash或信封非法而隔离的行数"
        }
      },
      "required": [
        "relayed",
        "pending",
        "quarantined"
      ]
    },
    "ConsumeEventsInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "本域事件订阅循环参数；未标可选字段均必填",
      "properties": {
        "consumerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "本域模块slug，须与服务身份一致"
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 4,
          "description": "不同subject同时处理上限；同subject始终串行"
        }
      },
      "required": [
        "consumerId",
        "maxInFlight"
      ]
    },
    "ConsumeEventsResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "订阅循环退出时的累计计数；正常运行期间不返回",
      "properties": {
        "acknowledged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "handler成功返回并已确认的处理次数；明确跳过的投递另计skipped"
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "旧dataEpoch或handler以ErrEventSkipped明确标记重复/无须应用，且确认成功的投递次数"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "信封/schema、handler或确认失败的未确认尝试次数，等待jobs重投；正常运行不伪报零"
        }
      },
      "required": [
        "acknowledged",
        "skipped",
        "failed"
      ]
    },
    "JobExecutionInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "任务执行函数的统一输入；由本域领取循环从jobs claim构造完整输入引用和worker/fence；进程内另附不序列化的CheckLease(context.Context) error，领域在不可逆决定前锁外调用，租约未知或取消失败关闭",
      "properties": {
        "jobId": {
          "$ref": "#/$defs/Identifier",
          "description": "jobs任务ID"
        },
        "jobType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "description": "本域jobTypes登记的类型"
        },
        "inputRef": {
          "$ref": "#/$defs/ObjectRef",
          "description": "创建任务时固定的完整不可变引用；不得裁剪owner/version/hash/byteSize/mediaType"
        },
        "fencingToken": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "本次租约fence；写回前在共用任务表上核对"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "第几次领取"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier",
          "description": "任务所属数据代次"
        },
        "workerId": {
          "$ref": "#/$defs/Identifier",
          "description": "本次持有租约的worker，与jobId/fence共同绑定"
        }
      },
      "required": [
        "jobId",
        "workerId",
        "jobType",
        "inputRef",
        "fencingToken",
        "attempt",
        "dataEpoch"
      ]
    },
    "JobExecutionResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "任务执行结果；由领取循环转为completeJob或failJob",
      "properties": {
        "state": {
          "enum": [
            "succeeded",
            "retry",
            "failed",
            "cancelled"
          ],
          "description": "retry表示可重试失败"
        },
        "resultRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "可选完整不可变结果引用；无结果时省略或null，不制造空ObjectRef"
        },
        "errorCode": {
          "$ref": "#/$defs/ErrorCode",
          "description": "可选；失败时的登记错误码"
        },
        "paidResultRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 10000,
          "description": "已付费成功的持久结果标识；取消或重试同样保留，不自动重算"
        }
      },
      "required": [
        "state"
      ]
    },
    "WorkerLoopInput": {
      "type": "object",
      "additionalProperties": false,
      "description": "本域任务领取循环参数",
      "properties": {
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "同时执行的任务上限"
        }
      },
      "required": [
        "maxConcurrency"
      ]
    },
    "WorkerLoopResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "领取循环退出时的累计计数",
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "成功完成数"
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "失败或取消数"
        }
      },
      "required": [
        "completed",
        "failed"
      ]
    },
    "EventDelivery": {
      "type": "object",
      "additionalProperties": false,
      "description": "事件处理函数的统一输入",
      "properties": {
        "envelope": {
          "$ref": "#/$defs/EventEnvelope",
          "description": "已校验的事件信封"
        }
      },
      "required": [
        "envelope"
      ]
    },
    "EventHandled": {
      "type": "object",
      "additionalProperties": false,
      "description": "事件处理结果",
      "properties": {
        "applied": {
          "type": "boolean",
          "description": "false表示重复或低revision的无操作"
        }
      },
      "required": [
        "applied"
      ]
    },
    "UILocale": {
      "type": "string",
      "description": "当前已随界面打包的规范后台语言；站点内容翻译语言不等于已有界面catalog",
      "enum": [
        "zh-Hans",
        "en"
      ],
      "default": "zh-Hans"
    },
    "AdminRouteKey": {
      "type": "string",
      "description": "后台相对页面键；路径/权限由permission-groups.adminRoutes唯一映射，不接受URL、query或未登记键",
      "enum": [
        "dashboard",
        "me",
        "content",
        "media",
        "localization",
        "models",
        "memory",
        "qa",
        "knowledge",
        "guard",
        "jobs",
        "analytics",
        "settings",
        "accounts",
        "backup",
        "sites",
        "team",
        "myai",
        "privateAccess",
        "platform"
      ],
      "default": "dashboard"
    },
    "PortalPreferences": {
      "type": "object",
      "additionalProperties": false,
      "description": "identity拥有的自身UI偏好；保存不改变账户权限/认证水位，目标页须当前授权",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "default": "system"
        },
        "locale": {
          "$ref": "#/$defs/UILocale"
        },
        "defaultRoute": {
          "$ref": "#/$defs/AdminRouteKey"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "theme",
        "locale",
        "defaultRoute",
        "revision"
      ]
    },
    "ReferenceSourceDecision": {
      "type": "object",
      "additionalProperties": false,
      "description": "资源pin源的最小持久决定；COMMITTED优先，404/pending/未知都不能作为release证据",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "committed",
            "aborted",
            "rejected"
          ]
        },
        "siteId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceOperationId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceObjectId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceRevisionId": {
          "$ref": "#/$defs/Identifier"
        },
        "sourceVersion": {
          "$ref": "#/$defs/Revision"
        },
        "referenceDigest": {
          "$ref": "#/$defs/Hash"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "state",
        "siteId",
        "sourceOperationId",
        "sourceObjectId",
        "sourceRevisionId",
        "sourceVersion",
        "referenceDigest",
        "dataEpoch"
      ]
    },
    "ModelOutput": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型完整结果；聊天可携带工具调用，text仍为完整文本（纯工具调用时为空串）。工具参数不通过文本delta执行。",
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "embedding",
            "rerank",
            "chat",
            "vision",
            "translation",
            "decision"
          ]
        },
        "embeddingSpace": {
          "$ref": "#/$defs/EmbeddingSpace"
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65536,
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "candidateIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "text": {
          "type": "string",
          "maxLength": 65536,
          "description": "真实完整文本；生产方UTF8字节总数另限64KiB。显式空串是已证明空输出，字段缺失不是空结果。"
        },
        "decision": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "type": "object"
          },
          "description": "decision能力的类型化答案：题目ID→该题答案（noul概率、choice选项与各选项概率、score加权分）；不含文本。"
        },
        "toolCalls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/GatewayToolCall"
          }
        },
        "finishReason": {
          "type": "string",
          "enum": [
            "stop",
            "tool_calls",
            "length",
            "content_filter"
          ]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "仅供应方实际报告的输入与输出词元；未知字段缺失，不用估算或零替代。",
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "capability"
      ],
      "oneOf": [
        {
          "properties": {
            "capability": {
              "const": "embedding"
            }
          },
          "required": [
            "embeddingSpace",
            "vectors"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "candidateIds"
                ]
              },
              {
                "required": [
                  "decision"
                ]
              },
              {
                "required": [
                  "toolCalls"
                ]
              },
              {
                "required": [
                  "finishReason"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "capability": {
              "const": "rerank"
            }
          },
          "required": [
            "candidateIds"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "embeddingSpace"
                ]
              },
              {
                "required": [
                  "vectors"
                ]
              },
              {
                "required": [
                  "decision"
                ]
              },
              {
                "required": [
                  "toolCalls"
                ]
              },
              {
                "required": [
                  "finishReason"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "capability": {
              "enum": [
                "chat",
                "vision",
                "translation"
              ]
            }
          },
          "required": [
            "text"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "embeddingSpace"
                ]
              },
              {
                "required": [
                  "vectors"
                ]
              },
              {
                "required": [
                  "candidateIds"
                ]
              },
              {
                "required": [
                  "decision"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "capability": {
              "const": "decision"
            }
          },
          "required": [
            "decision"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "embeddingSpace"
                ]
              },
              {
                "required": [
                  "vectors"
                ]
              },
              {
                "required": [
                  "candidateIds"
                ]
              },
              {
                "required": [
                  "toolCalls"
                ]
              },
              {
                "required": [
                  "finishReason"
                ]
              }
            ]
          }
        }
      ]
    },
    "OwnerRecoveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "$ref": "#/$defs/Identifier"
        },
        "owner": {
          "type": "string",
          "enum": [
            "memory",
            "qa",
            "knowledge",
            "public-site",
            "localization",
            "analytics",
            "media"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "inputRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "rootOperationId": {
          "$ref": "#/$defs/Identifier"
        },
        "dataEpoch": {
          "$ref": "#/$defs/Identifier"
        },
        "expiredFence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workerId": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/Identifier"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancelRequested": {
          "type": "boolean"
        }
      },
      "required": [
        "jobId",
        "owner",
        "type",
        "inputRef",
        "rootOperationId",
        "dataEpoch",
        "expiredFence",
        "workerId",
        "attempt",
        "cancelRequested"
      ],
      "description": "jobs从自己持久任务与失效租约读取，只读owner恢复证明；不得浏览器自报或新建dedupeKey绕过孤立。"
    },
    "OwnerRecoveryResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "safeToRetry",
            "pending",
            "unknown"
          ]
        },
        "resultRef": {
          "$ref": "#/$defs/ObjectRef"
        },
        "paidResultRefs": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      },
      "required": [
        "status",
        "paidResultRefs"
      ],
      "description": "owner以精确inputRef/root/epoch/fence/attempt匹配原持久事实；不能证明安全则pending/unknown。completed只交原结果，safeToRetry必须能复用原hash/checkpoint/付费结果且无未决派发费用；未知绝不作0或重算。"
    },
    "AssetVersionRef": {
      "type": "object",
      "description": "完整不可变资源引用；正文按SHA内容寻址，文件版本不覆盖",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "$ref": "#/$defs/Identifier",
          "description": "逻辑资源ID"
        },
        "version": {
          "$ref": "#/$defs/Revision",
          "description": "不可变对象版本"
        },
        "sha256": {
          "$ref": "#/$defs/Hash",
          "description": "Hash"
        },
        "mediaType": {
          "type": "string",
          "description": "嗅探确认MIME",
          "minLength": 1,
          "maxLength": 128
        },
        "byteSize": {
          "type": "integer",
          "description": "字节数",
          "minimum": 0,
          "maximum": 2147483648
        }
      },
      "required": [
        "assetId",
        "version",
        "sha256",
        "mediaType",
        "byteSize"
      ]
    },
    "GatewayToolCall": {
      "type": "object",
      "additionalProperties": false,
      "description": "模型提出的一次工具调用；仅在完整结束且参数为JSON对象后交业务域执行。signature原样保留供应方的工具思考签名。",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "arguments": {
          "type": "string",
          "minLength": 2,
          "maxLength": 65536
        },
        "signature": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    }
  }
}
