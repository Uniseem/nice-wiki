  "superadminOnly": [
    "account.manage",
    "model.manage",
    "audit.read",
    "backup.manage",
    "system.manage",
    "superadmin"
  ],
  "rule": "只有旧10项功能开关；技术grants由identity派生，浏览器不能自选。超管拥有全部登记管理权限；后台服务必须验证委托者实际技术权限。job.manage由本域任务owner业务权限派生，仅允许管理获授权业务任务，不能以此操作任意任务或系统任务。media.read用于管理对象，公开资源通过发布引用门禁。 job.manage只是入口粗能力，按jobManagementGrants中任一当前技术权限派生；jobs必须再按持久任务type/owner对应managementPermission核对最新业务授权，系统类型用system.manage。",
  "jobManagementGrants": [
    "system.manage",
    "backup.manage",
    "knowledge.manage",
    "localization.manage",
    "media.manage",
    "memory.manage",
    "content.publish",
    "qa.manage",
    "account.manage",
    "site.manage",
    "model.manage",
    "guard.manage"
  ],
  "eventManagementPermissions": {
    "identity": "account.manage",
    "site-config": "site.manage",
    "content": "content.publish",
    "media": "media.manage",
    "model-gateway": "model.manage",
    "knowledge": "knowledge.manage",
    "qa": "qa.manage",
    "localization": "localization.manage",
    "memory": "memory.manage",
    "traffic-guard": "guard.manage",
    "jobs": "system.manage",
    "analytics": "system.manage",
    "data-protection": "backup.manage"
  }
}
