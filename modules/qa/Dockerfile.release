# qa 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10008 qa && mkdir -p /data/qa && chown 10008:10008 /data/qa
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/qa /usr/local/bin/qa
USER 10008:10008
EXPOSE 8107
VOLUME ["/data/qa"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/qa"]
CMD ["--config", "/config/qa.json"]
