{
  "openapi": "3.1.0",
  "info": {
    "title": "主系统服务契约",
    "version": "1.0.0",
    "description": "R1实施中的入口契约；业务验收与部署未执行，完整应用缺失handler时失败关闭。"
  },
  "servers": [
    {
      "url": "/portal",
      "description": "入口内部挂载前缀；具体主机由部署目录指定，不在合同写凭据"
    }
  ],
  "paths": {
    "/v1/bootstrap": {
      "get": {
        "operationId": "loadBootstrap",
        "summary": "加载后台外壳",
        "description": "调用函数 portal.LoadBootstrap；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.LoadBootstrap",
        "x-permission": "portal.use",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "加载后台外壳的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/LoadBootstrapResult"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION：字段、枚举、范围、格式或状态前置条件不合法；不记录敏感原值",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED：会话、委托或服务证明缺失、失效或被撤销",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE：权威依赖、存储或密钥不可用；不可把未知状态当允许",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/preferences": {
      "get": {
        "operationId": "readPreferences",
        "summary": "读自身偏好",
        "description": "调用函数 portal.ReadPreferences；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.ReadPreferences",
        "x-permission": "portal.use",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "读自身偏好的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/ReadPreferencesResult"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN：主体没有所需操作权限，或站点/资源作用域不匹配",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE：权威依赖、存储或密钥不可用；不可把未知状态当允许",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePreferences",
        "summary": "修改自身偏好",
        "description": "调用函数 portal.UpdatePreferences；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.UpdatePreferences",
        "x-permission": "portal.use",
        "security": [
          {
            "sessionCookie": [],
            "csrfToken": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "修改自身偏好的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/UpdatePreferencesResult"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION：字段、枚举、范围、格式或状态前置条件不合法；不记录敏感原值",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT：状态冲突、唯一约束冲突或 operationId 被不同请求摘要复用",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "types.json#/$defs/UpdatePreferencesInput"
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "openEventStream",
        "summary": "权限过滤 SSE",
        "description": "调用函数 portal.OpenEventStream；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.OpenEventStream",
        "x-permission": "portal.use",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
              "description": "签名不透明游标",
              "minLength": 0,
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "权限过滤 SSE的成功回执",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE frame 的 data 符合 PortalEvent",
                  "x-event-schema": {
                    "$ref": "types.json#/$defs/PortalEvent"
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION：字段、枚举、范围、格式或状态前置条件不合法；不记录敏感原值",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN：主体没有所需操作权限，或站点/资源作用域不匹配",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "STALE_RESULT：事件/计算针对已过期源版本，拒绝覆盖新状态",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/readiness": {
      "get": {
        "operationId": "collectReadiness",
        "summary": "读取入口 readiness",
        "description": "调用函数 portal.CollectReadiness；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.CollectReadiness",
        "x-permission": "system.manage",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "读取入口 readiness的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/CollectReadinessResult"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION：字段、枚举、范围、格式或状态前置条件不合法；不记录敏感原值",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/barriers": {
      "post": {
        "operationId": "acquireBarrier",
        "summary": "取得入口维护屏障",
        "description": "调用函数 portal.AcquireBarrier；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.AcquireBarrier",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "取得入口维护屏障的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/BarrierStatus"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN：主体没有所需操作权限，或站点/资源作用域不匹配",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "LOCKED：锁、屏障、删除 fence 或正在处理的互斥操作阻止执行",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE：权威依赖、存储或密钥不可用；不可把未知状态当允许",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "types.json#/$defs/BarrierRequest"
              }
            }
          }
        }
      }
    },
    "/v1/barriers/{barrierId}": {
      "delete": {
        "operationId": "releaseBarrier",
        "summary": "释放入口屏障",
        "description": "调用函数 portal.ReleaseBarrier；参数/结果以 types.json 为准。X-Operation-Id、X-Data-Epoch、服务 proof/CSRF 的验证在入口与本服务均执行。",
        "x-handler": "portal.ReleaseBarrier",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "barrierId",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "Identifier"
            },
            "description": "路径中的barrierId；合并到 handler input，不能跨站点"
          }
        ],
        "responses": {
          "200": {
            "description": "释放入口屏障的成功回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "types.json#/$defs/ReleaseBarrierResult"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN：主体没有所需操作权限，或站点/资源作用域不匹配",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "VERSION_MISMATCH：expectedRevision、对象版本或 dataEpoch 已改变",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "types.json#/$defs/releaseBarrierRequest"
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "本域进程存活",
        "x-handler": "portal.Health",
        "x-permission": "anonymous",
        "security": [],
        "responses": {
          "200": {
            "description": "进程存活，无依赖/模型探测",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "进程不可用",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "summary": "本域启动/恢复就绪",
        "x-handler": "portal.Ready",
        "x-permission": "anonymous",
        "security": [],
        "responses": {
          "200": {
            "description": "本域ready或维护control-ready，公开业务门禁另判",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/ServiceReadiness"
                }
              }
            }
          },
          "503": {
            "description": "关键依赖或epoch/journal未ready",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT(EdDSA)",
        "description": "调用方服务用部署时登记的Ed25519私钥签发≤60秒断言（iss=调用服务、aud=本服务、method、path、bodyHash、jti）；接收方按trustAnchorRef服务公钥表验证并拒绝重放"
      },
      "userDelegation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Portal-Proof",
        "description": "portal为当前请求签发的≤10秒用户委托证明（actor、grants、sessionVersion、route、bodyHash）；下游链路原样传递，接收方仍经identity:checkAuthorization核权限与会话版本"
      },
      "visitorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nw_visitor",
        "description": "traffic-guard签署的伪名访客会话；只用于公开问答与语言偏好，不含IP"
      },
      "admissionPermit": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admission-Permit",
        "description": "portal为公开AI请求向traffic-guard申请的准入许可；问答服务消费，网关本地验签"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nw_sid",
        "description": "identity签发的HttpOnly Secure SameSite=Strict会话；只由portal读取"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "写操作必需；portal经identity核对会话绑定"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nw_refresh",
        "description": "仅portal读取的host-only Path=/ Secure HttpOnly SameSite=Strict刷新秘密；浏览器JSON不接受或返回raw secret"
      }
    },
    "schemas": {
      "PortalSiteConfigResponse": {
        "$ref": "./types.json#/$defs/PortalSiteConfigResponse"
      }
    }
  },
  "x-browser-auth-adapters": {
    "owner": "identity",
    "method": "POST",
    "operations": {
      "createSession": {
        "path": "/v1/sessions",
        "requestSchema": "../../identity/contracts/types.json#/$defs/CreateSessionInput",
        "responseSchema": "./types.json#/$defs/BrowserCreateSessionResult",
        "tokenField": "tokens",
        "loginNetworkScopes": true
      },
      "registerFirstSuperadmin": {
        "path": "/v1/registration",
        "requestSchema": "../../identity/contracts/types.json#/$defs/RegisterFirstSuperadminInput",
        "responseSchema": "./types.json#/$defs/BrowserRegisterFirstSuperadminResult",
        "tokenField": "tokens",
        "loginNetworkScopes": true
      },
      "refreshSession": {
        "path": "/v1/sessions:refresh",
        "requestSchema": "./types.json#/$defs/BrowserRefreshSessionInput",
        "responseSchema": "./types.json#/$defs/BrowserRefreshSessionResult",
        "tokenField": "tokens",
        "requestAdapter": "仅从nw_refresh读取秘密构造identity.RefreshSessionInput；重算实际正文hash；浏览器正文严格空对象"
      },
      "changePassword": {
        "path": "/v1/self/password:change",
        "requestSchema": "../../identity/contracts/types.json#/$defs/ChangePasswordInput",
        "responseSchema": "./types.json#/$defs/BrowserChangePasswordResult",
        "tokenField": "currentSessionTokens"
      }
    },
    "cookies": {
      "access": {
        "name": "nw_sid",
        "httpOnly": true,
        "secure": true,
        "sameSite": "Strict",
        "path": "/",
        "hostOnly": true,
        "expires": "identity SessionTokens.expiresAt"
      },
      "refresh": {
        "name": "nw_refresh",
        "httpOnly": true,
        "secure": true,
        "sameSite": "Strict",
        "path": "/",
        "hostOnly": true,
        "expires": "浏览器session cookie；绝对期限仅由identity权威核对"
      }
    },
    "successStatus": 200,
    "responseBodyLimitBytes": 65536,
    "failurePolicy": "固定操作以外不设置认证cookie；认证响应一律no-store。非200只输出标准Problem安全字段，不设/清cookie；敏感成功回执CONFLICT要求重新登录，不盲重放。成功DTO/媒体类型/期限/字段错误时在任何body或cookie写出前INTEGRITY_ERROR。",
    "csrf": "仅安全session.csrfToken回浏览器内存；后续写请求使用X-CSRF-Token，不设置可读cookie，不持久化raw token。",
    "networkScopes": "仅createSession/registerFirstSuperadmin调用platform.PrivateNetworkScopes，从真实socket RemoteAddr和仅受信CIDR的XFF生成当前及上一UTC日HMAC并签入OperationContext；浏览器头不能指定scope。"
  },
  "x-browser-session-revocation": {
    "owner": "identity",
    "operationId": "revokeSession",
    "method": "DELETE",
    "path": "/v1/sessions/{sessionId}",
    "rule": "仅当已权威校验AuthContext.sessionId等于静态路由参数sessionId且上游200 revoked=true才删除nw_sid/nw_refresh；撤销其他设备及任何失败均不清当前cookie",
    "cookieDeletion": "保持host-only Path=/ Secure HttpOnly SameSite=Strict，MaxAge=-1且Expires过去",
    "responseBodyLimitBytes": 65536
  },
  "x-runtime-payload-schemas": [
    "BeaconPublicRequest",
    "PortalSiteConfigResponse"
  ]
}
