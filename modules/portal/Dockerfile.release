# portal 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10000 portal && mkdir -p /data/portal && chown 10000:10000 /data/portal
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/portal /usr/local/bin/portal
COPY release/web /web
COPY modules/portal/config/routes.json /config/routes.json
ENV NW_WEB_DIR=/web
USER 10000:10000
EXPOSE 8080
VOLUME ["/data/portal"]
WORKDIR /
ENTRYPOINT ["/usr/local/bin/portal"]
CMD ["--config", "/config/portal.json"]
