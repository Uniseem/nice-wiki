{
  "moduleId": "M03",
  "module": "site-config",
  "version": 1,
  "phase": "design",
  "requirements": [
    {
      "id": "M03-R01",
      "description": "D55首超管后两步初始化无需AI",
      "acceptance": "无渠道/密钥/模型/探测仍完成站名/默认zh-Hans语言并创建编辑预览发布"
    },
    {
      "id": "M03-R02",
      "description": "D17一屏完整hero",
      "acceptance": "主副标题、Welcome To可选翻译、0–3按钮、纯色/图/动图/视频、遮罩、浅深文字，首页无其他内容"
    },
    {
      "id": "M03-R03",
      "description": "D34可关闭单条横幅",
      "acceptance": "文本/链接/时间窗可设置且翻译，bannerId localStorage关闭同条不再显示，不用cookie"
    },
    {
      "id": "M03-R04",
      "description": "站点品牌与页脚",
      "acceptance": "站名logo图标主题色默认分享图，版权/链接/ICP/默认源码链接完整可设置"
    },
    {
      "id": "M03-R05",
      "description": "D16设置文件权威及历史回滚",
      "acceptance": "不含secret的settings不可变文件可镜像git；恢复/回滚不共享可写目录"
    },
    {
      "id": "M03-R06",
      "description": "恢复维护唯一权威",
      "acceptance": "control区不随恢复替换，14个有状态域switched回执未齐不得退出维护"
    },
    {
      "id": "M03-R901",
      "description": "本域独立Go module、main入口、完整依赖装配、HTTP/worker生命周期、镜像/manifest及既有UI独立构建；健康和就绪不调用模型。",
      "acceptance": "未来分别从本域目录构建/启动，验证所有登记handler均装配、Health/Ready语义及安全关闭；当前未实现、未执行。"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "mode": "sync",
      "purpose": "首注册已生成唯一superadmin/siteId；权限验证",
      "failurePolicy": "未注册不能初始化，写入关闭"
    },
    {
      "module": "content",
      "mode": "sync",
      "purpose": "首页文档当前发布引用及可见性",
      "failurePolicy": "未知/撤回引用不公开"
    },
    {
      "module": "media",
      "mode": "sync",
      "purpose": "首页ready资源与引用pin",
      "failurePolicy": "引用不确定禁止写入/清理"
    },
    {
      "module": "jobs",
      "mode": "event",
      "purpose": "公告计划与配置事件",
      "failurePolicy": "保留outbox；时间窗和撤回仍由权威同步判断"
    },
    {
      "module": "public-site",
      "mode": "sync",
      "purpose": "首页文档当前语言公开URL与锚点权威，绝不由配置域拼slug",
      "failurePolicy": "保留hero及按钮，目标依赖未知仅禁用相应按钮；写入时权威引用未知关闭"
    },
    {
      "module": "qa",
      "mode": "sync",
      "purpose": "公开问答免费只读能力，不调用模型或连接探测",
      "failurePolicy": "保留hero及按钮，目标依赖未知仅禁用相应按钮；写入时权威引用未知关闭"
    }
  ],
  "files": [
    {
      "path": "modules/site-config/internal/config_service.go",
      "kind": "handwritten",
      "purpose": "读取后台站点配置"
    },
    {
      "path": "modules/site-config/internal/config_validator.go",
      "kind": "handwritten",
      "purpose": "校验配置所有字段和关联约束"
    },
    {
      "path": "modules/site-config/internal/language_service.go",
      "kind": "handwritten",
      "purpose": "规范基准语言 tag"
    },
    {
      "path": "modules/site-config/internal/home_service.go",
      "kind": "handwritten",
      "purpose": "保存一屏hero权威配置、公开安全投影和媒体引用持久恢复"
    },
    {
      "path": "modules/site-config/internal/home_validator.go",
      "kind": "handwritten",
      "purpose": "验证首页目标与引用"
    },
    {
      "path": "modules/site-config/internal/runtime_state_service.go",
      "kind": "handwritten",
      "purpose": "读取独立控制库权威运行状态"
    },
    {
      "path": "modules/site-config/internal/runtime_store.go",
      "kind": "handwritten",
      "purpose": "打开独立control.db与active/site-config.db并持久化运行状态、激活回执、业务索引与操作幂等记录"
    },
    {
      "path": "modules/site-config/internal/write_epoch.go",
      "kind": "handwritten",
      "purpose": "所有业务写入执行epoch与屏障检查"
    },
    {
      "path": "modules/site-config/internal/migrations/migrations.go",
      "kind": "handwritten",
      "purpose": "内嵌本域control.db只追加SQL迁移并校验编号连续"
    },
    {
      "path": "modules/site-config/internal/migrations/0001_control.sql",
      "kind": "migration",
      "purpose": "初始control.db表：runtime_state、activation_receipts、runtime_operation_receipts与schema_migrations"
    },
    {
      "path": "modules/site-config/internal/migrations/active/0001_active.sql",
      "kind": "migration",
      "purpose": "初始active业务索引表：schema_migrations、site_config_state、config_revision_index与announcement_heads"
    },
    {
      "path": "modules/site-config/internal/initialization_service.go",
      "kind": "handwritten",
      "purpose": "无需AI完成首站点初始化"
    },
    {
      "path": "modules/site-config/internal/initialization_defaults.go",
      "kind": "handwritten",
      "purpose": "确定性生成首次基础配置"
    },
    {
      "path": "modules/site-config/internal/initialization_repository.go",
      "kind": "handwritten",
      "purpose": "持久化不可反悔的初始化决定"
    },
    {
      "path": "modules/site-config/internal/announcement_validator.go",
      "kind": "handwritten",
      "purpose": "校验公告纯文本正文并规范序列化"
    },
    {
      "path": "modules/site-config/internal/announcement_files.go",
      "kind": "handwritten",
      "purpose": "持久写不可变公告正文文件"
    },
    {
      "path": "modules/site-config/internal/operation_repository.go",
      "kind": "handwritten",
      "purpose": "查询配置幂等回执"
    },
    {
      "path": "modules/site-config/internal/outbox_repository.go",
      "kind": "handwritten",
      "purpose": "将配置事件与业务提交原子登记，并把真实outbox单批转发装配委托给平台"
    },
    {
      "path": "modules/site-config/internal/object_reader.go",
      "kind": "handwritten",
      "purpose": "经协议读取本域正文或快照对象"
    },
    {
      "path": "modules/site-config/internal/branding_service.go",
      "kind": "handwritten",
      "purpose": "更新站名/logo/图标/主题色/默认分享图"
    },
    {
      "path": "modules/site-config/internal/footer_service.go",
      "kind": "handwritten",
      "purpose": "更新页脚版权/自定义链接/ICP备案/源码链接"
    },
    {
      "path": "modules/site-config/internal/banner_service.go",
      "kind": "handwritten",
      "purpose": "保存单条可关闭公告横幅"
    },
    {
      "path": "modules/site-config/internal/config_files.go",
      "kind": "handwritten",
      "purpose": "写权威版本化站点设置文件"
    },
    {
      "path": "modules/site-config/internal/config_history.go",
      "kind": "handwritten",
      "purpose": "读取可回滚的站点设置历史"
    },
    {
      "path": "modules/site-config/internal/resource_reference_reader.go",
      "kind": "handwritten",
      "purpose": "向媒体返回站点设置权威资源引用快照"
    },
    {
      "path": "modules/site-config/cmd/site-config/main.go",
      "kind": "handwritten",
      "purpose": "本域唯一Go可执行入口；不放产品算法"
    },
    {
      "path": "modules/site-config/internal/app/wire.go",
      "kind": "handwritten",
      "purpose": "本域依赖装配和完整HTTP路由绑定；不共享存储"
    },
    {
      "path": "modules/site-config/internal/transport/server.go",
      "kind": "handwritten",
      "purpose": "HTTP/worker生命周期、优雅关闭、匿名健康与就绪"
    },
    {
      "path": "modules/site-config/go.mod",
      "kind": "config",
      "purpose": "独立module nice-wiki/modules/site-config；固定Go工具链和本域实际库依赖，不能import另一服务internal或用latest浮动依赖"
    },
    {
      "path": "modules/site-config/go.sum",
      "kind": "generated",
      "purpose": "go.mod依赖校验锁；由go mod download生成，纳入版本以可重现构建"
    },
    {
      "path": "modules/site-config/Dockerfile",
      "kind": "config",
      "purpose": "本域多阶段独立镜像：按go.mod工具链构建./cmd/site-config；如有UI根先pnpm frozen-lockfile构建dist；运行只带server/config/dist，以非root用户挂本域独占data卷，HTTP由反代提供HTTPS"
    },
    {
      "path": "modules/site-config/Makefile",
      "kind": "config",
      "purpose": "generate校验并生成合同绑定；build执行go build ./cmd/site-config与本域UI build；run传配置；verify核编译和合同引用。无共享业务启动器，不创建测试样例"
    },
    {
      "path": "modules/site-config/config/service.defaults.json",
      "kind": "config",
      "purpose": "ServiceConfig默认值/严格字段及CLI>env>file>defaults覆盖；现有配置文件扩展基础启动字段而不重复维护；secret仅ref"
    },
    {
      "path": "modules/site-config/deploy/manifest.json",
      "kind": "config",
      "purpose": "唯一服务slug/image/command/http端口/本域data卷/外部secret refs/所需dependency endpoints/healthz-readyz探针；不塞真实主机凭证"
    },
    {
      "path": "modules/site-config/internal/gen/openapi.gen.go",
      "kind": "generated",
      "purpose": "make gen由oapi-codegen从本域contracts/openapi.json（含types.json与公共schema引用）生成DTO与严格服务端接口；不手改"
    },
    {
      "path": "modules/site-config/internal/gen/clients.gen.go",
      "kind": "generated",
      "purpose": "make gen由oapi-codegen按本域dependencies中的生产方operation生成调用客户端，自动附platform服务断言；不手改"
    },
    {
      "path": "modules/site-config/internal/gen/oapi-codegen.yaml",
      "kind": "config",
      "purpose": "oapi-codegen配置：输出包gen、strict-server、只生成本域与所需生产方operation"
    },
    {
      "path": "modules/site-config/internal/migrations/active/0002_initialization.sql",
      "kind": "migration",
      "purpose": "初始化不可反悔决定、完整准备配置及SHA256、幂等回执和当前协调状态；不替代settings权威文件"
    },
    {
      "path": "modules/site-config/internal/migrations/active/0003_config_commit.sql",
      "kind": "migration",
      "purpose": "只追加配置操作原始身份、摘要和不可重建结果回执；outbox结构复用platform"
    },
    {
      "path": "modules/site-config/internal/migrations/active/0004_config_operations.sql",
      "kind": "migration",
      "purpose": "一般设置操作的完整候选配置规范JSON/hash，只是重试恢复材料；正式配置仍以settings文件为权威"
    },
    {
      "path": "modules/site-config/internal/migrations/active/0005_home_reference_decisions.sql",
      "kind": "migration",
      "purpose": "追加首页资源pin intent、持久终局、原pin及确认/释放续办阶段，不替代settings文件权威"
    },
    {
      "path": "modules/site-config/web/src/index.tsx",
      "kind": "ui",
      "purpose": "站点设置：基本信息、品牌图片、首页主视觉（含预览）、公告横幅、页脚"
    }
  ],
  "jobTypes": [],
  "backgroundTasks": [
    {
      "function": "site-config.RecoverAnnouncementJournal",
      "schedule": "启动时（入口开放前）",
      "purpose": "恢复正文文件与提交日志"
    },
    {
      "function": "site-config.RelayOutbox",
      "schedule": "启动后持续，空闲每1秒",
      "purpose": "执行一次单批outbox转发；启动补发与轮询循环只由完整Application后台入口装配"
    },
    {
      "function": "site-config.RecoverConfigJournal",
      "schedule": "启动时（入口开放前）",
      "purpose": "启动前恢复settings权威文件提交决定"
    },
    {
      "function": "site-config.RecoverHomeReferences",
      "schedule": "完整Application构造后由公共RunRecoveryLoop持续运行；每1秒单批最多100项，维护和未知安全窗口暂停",
      "purpose": "按明确决定有界收敛首页媒体pin"
    }
  ],
  "consumes": {
    "identity": [
      "checkAuthorization"
    ],
    "jobs": [
      "publishEvent"
    ],
    "media": [
      "acquireResourceReferences",
      "confirmResourceReferences",
      "readAsset",
      "releaseResourceReferences"
    ],
    "public-site": [
      "resolvePublishedLink"
    ],
    "qa": [
      "readPublicCapability"
    ]
  }
}
