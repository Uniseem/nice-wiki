# site-config 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10003 site-config && mkdir -p /data/site-config && chown 10003:10003 /data/site-config
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/site-config /usr/local/bin/site-config
USER 10003:10003
EXPOSE 8102
VOLUME ["/data/site-config"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/site-config"]
CMD ["--config", "/config/site-config.json"]
