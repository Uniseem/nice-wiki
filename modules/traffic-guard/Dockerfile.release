# traffic-guard 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10011 traffic-guard && mkdir -p /data/traffic-guard && chown 10011:10011 /data/traffic-guard
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/traffic-guard /usr/local/bin/traffic-guard
USER 10011:10011
EXPOSE 8110
VOLUME ["/data/traffic-guard"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/traffic-guard"]
CMD ["--config", "/config/traffic-guard.json"]
