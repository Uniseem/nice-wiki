# knowledge 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10007 knowledge && mkdir -p /data/knowledge && chown 10007:10007 /data/knowledge
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/knowledge /usr/local/bin/knowledge
USER 10007:10007
EXPOSE 8106
VOLUME ["/data/knowledge"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/knowledge"]
CMD ["--config", "/config/knowledge.json"]
