{
  "openapi": "3.1.0",
  "info": {
    "title": "analytics HTTP 合同",
    "version": "1.0.0",
    "description": "设计合同；未实现或运行真实接口。服务间HTTP/JSON/SSE，无共享数据库。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://analytics:8080"
    }
