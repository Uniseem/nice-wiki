    "/v1/beacons": {
      "post": {
        "operationId": "ingestBeacon",
        "summary": "匿名HTTP接收",
        "description": "204；严格allowlist，未知字段拒绝400，不携带IP/正文",
        "x-handler": "analytics.IngestBeacon",
        "x-permission": "anonymous",
        "x-data-epoch-required": true,
        "responses": {
          "204": {
            "description": "204；严格allowlist，未知字段拒绝400，不携带IP/正文"
          },
          "400": {
            "description": "公共错误；VALIDATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "公共错误；VERSION_MISMATCH",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.json#/$defs/IngestBeaconRequestBody"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "缺省由入口生成；幂等写另使用Idempotency-Key绑定inputHash"
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "本操作幂等键，同键不同规范body hash返回409"
          }
        ],
        "security": []
      }
    },
    "/v1/statistics/pages": {
      "get": {
        "operationId": "queryPageStatistics",
        "summary": "访问汇总查询",
        "description": "按UTC小时或站点时区日聚合访问",
        "x-handler": "analytics.QueryPageStatistics",
        "x-permission": "stats.read",
        "x-data-epoch-required": true,
        "responses": {
          "200": {
            "description": "按UTC小时或站点时区日聚合访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/QueryPageStatisticsResult"
                }
              }
            }
          },
          "403": {
            "description": "公共错误；FORBIDDEN",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "400": {
            "description": "公共错误；VALIDATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Timestamp",
              "description": "RFC3339 UTC 时间；不含 null"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Timestamp",
              "description": "RFC3339 UTC 时间；不含 null"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string",
              "description": "locale；UTF-8；不得为 null",
              "maxLength": 35,
              "minLength": 1,
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            }
          },
          {
            "in": "query",
            "name": "documentId",
            "required": false,
            "schema": {
              "type": "string",
              "description": "documentId；UTF-8；不得为 null",
              "maxLength": 128,
              "minLength": 1
            }
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "缺省由入口生成；幂等写另使用Idempotency-Key绑定inputHash"
          }
        ],
        "security": [
          {
            "serviceAssertion": [],
            "userDelegation": []
          }
        ]
      }
    },
