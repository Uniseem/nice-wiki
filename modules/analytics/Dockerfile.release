# analytics 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10013 analytics && mkdir -p /data/analytics && chown 10013:10013 /data/analytics
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/analytics /usr/local/bin/analytics
USER 10013:10013
EXPOSE 8112
VOLUME ["/data/analytics"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/analytics"]
CMD ["--config", "/config/analytics.json"]
