{
  "slug": "analytics",
  "image": "nice-wiki-analytics",
  "command": ["/analytics", "--config", "/config/defaults.json"],
  "httpPort": 8112,
  "dataVolume": "/data/analytics",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "analytics-signing-key",
      "path": "/run/secrets/analytics-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    },
    {
      "module": "model-gateway",
      "endpoint": "http://model-gateway:8105",
      "env": "NW_DEP_MODEL_GATEWAY"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    },
    {
      "module": "data-protection",
      "endpoint": "http://data-protection:8113",
      "env": "NW_DEP_DATA_PROTECTION"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
