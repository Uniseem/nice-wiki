{
  "types": {
    "AuthProvider": {"description": "可用的第三方登录方式", "props": {"provider": "enum:github|google|linuxdo", "label": "string:64"}},
    "ReadAuthOptionsResult": {"description": "登录页需要的公开选项", "props": {"registrationOpen": "bool", "emailRegistration": "bool", "inviteRequired": "bool", "providers": "[AuthProvider]"}},
    "RegisterUserInput": {"description": "邮箱注册：不验证邮箱，需要注册邀请码（站主开放公开注册后可省略）", "props": {"email": "string:320:3", "password": "string:256:8", "passwordConfirmation": "string:256:8", "displayName": "string:100:1", "inviteCode": "string:128?"}},
    "RegisterUserResult": {"description": "注册成功并登录", "props": {"account": "Account", "tokens": "SessionTokens", "nextRoute": "enum:/admin/me|/admin/setup|/admin"}},
    "OauthStartInput": {"description": "开始第三方登录", "props": {"redirectUri": "string:512:1"}},
    "OauthStartResult": {"description": "授权跳转地址与一次性状态", "props": {"authorizeUrl": "string:2048", "state": "string:256"}},
    "OauthLoginInput": {"description": "第三方登录回调：用授权码换身份，首次登录自动建号", "props": {"code": "string:2048:1", "state": "string:256:1", "redirectUri": "string:512:1", "inviteCode": "string:128?"}},
    "UserLimits": {"description": "当前用户的站点与存储额度", "props": {"maxSites": "int:0", "siteCount": "int:0", "storageBytes": "int:0", "storageUsed": "int:0"}},
    "SiteSummary": {"description": "站点摘要（含当前用户在该站的角色）", "props": {"siteId": "id", "slug": "string:63", "name": "string:100", "status": "enum:active|suspended|deleted", "role": "enum:owner|editor|viewer", "visibility": "enum:public|private", "primaryHost": "string:253", "createdAt": "ts", "visitorQaDaily": "int:0", "qaPausedOn": "string:10", "grants": "[string:64]"}},
    "ListMySitesResult": {"description": "我能访问的站点", "props": {"sites": "[SiteSummary]", "limits": "UserLimits"}},
    "CreateSiteInput": {"description": "创建站点并成为所有者", "props": {"slug": "string:63:3", "name": "string:100:1", "baseLanguage": "string:35?"}},
    "SiteResult": {"description": "单个站点", "props": {"site": "SiteSummary"}},
    "UpdateSiteInput": {"description": "修改站点名称、可见性或访客每日提问上限", "props": {"name": "string:100:1?", "visibility": "enum:public|private?", "visitorQaDaily": "int:0:100000?"}},
    "RemovedResult": {"description": "删除结果", "props": {"removed": "bool"}},
    "SiteMember": {"description": "站点成员", "props": {"userId": "id", "displayName": "string:100", "email": "string:320", "role": "enum:owner|editor|viewer", "createdAt": "ts"}},
    "ListSiteMembersResult": {"description": "站点成员列表", "props": {"members": "[SiteMember]"}},
    "AddSiteMemberInput": {"description": "按邮箱邀请已注册用户成为协作者", "props": {"email": "string:320:3", "role": "enum:editor|viewer"}},
    "SiteMemberResult": {"description": "单个成员", "props": {"member": "SiteMember"}},
    "UpdateSiteMemberInput": {"description": "修改成员角色", "props": {"role": "enum:editor|viewer"}},
    "SiteDomain": {"description": "站点域名", "props": {"host": "string:253", "kind": "enum:subdomain|custom", "status": "enum:pending|verified|failed", "primary": "bool", "verifyName": "string:253", "verifyToken": "string:128", "verifiedAt": "ts?", "createdAt": "ts"}},
    "ListSiteDomainsResult": {"description": "站点域名列表", "props": {"domains": "[SiteDomain]"}},
    "AddSiteDomainInput": {"description": "绑定自定义域名", "props": {"host": "string:253:3"}},
    "SiteDomainResult": {"description": "单个域名", "props": {"domain": "SiteDomain"}},
    "ResolveHostResult": {"description": "域名对应的站点；只给入口与公开站使用", "props": {"siteId": "id", "slug": "string:63", "status": "enum:active|suspended|deleted", "visibility": "enum:public|private", "primaryHost": "string:253", "redirectHost": "string:253?", "platformHost": "string:253"}},
    "ProviderConfig": {"description": "第三方登录配置（不含密钥）", "props": {"provider": "enum:github|google|linuxdo|gdrive|onedrive|dropbox", "enabled": "bool", "clientId": "string:256", "clientSecretSet": "bool"}},
    "PlatformSettings": {"description": "平台设置", "props": {"registrationOpen": "bool", "emailRegistration": "bool", "inviteRequired": "bool", "defaultMaxSites": "int:0:1000", "defaultStorageBytes": "int:0", "defaultVisitorQaDaily": "int:0:1000000", "platformHost": "string:253", "sitesDomain": "string:253", "providers": "[ProviderConfig]"}},
    "ProviderUpdate": {"description": "第三方登录配置更新；clientSecret 省略表示不改", "props": {"provider": "enum:github|google|linuxdo|gdrive|onedrive|dropbox", "enabled": "bool", "clientId": "string:256", "clientSecret": "string:512?"}},
    "UpdatePlatformSettingsInput": {"description": "更新平台设置；省略的字段不改", "props": {"registrationOpen": "bool?", "emailRegistration": "bool?", "inviteRequired": "bool?", "defaultMaxSites": "int:0:1000?", "defaultStorageBytes": "int:0?", "defaultVisitorQaDaily": "int:0:1000000?", "platformHost": "string:253?", "sitesDomain": "string:253?", "providers": "[ProviderUpdate]?"}},
    "RegistrationInvite": {"description": "注册邀请码（只存摘要）", "props": {"inviteId": "id", "note": "string:200", "maxUses": "int:1", "used": "int:0", "expiresAt": "ts?", "revoked": "bool", "createdAt": "ts"}},
    "CreateRegistrationInviteInput": {"description": "站主生成注册邀请码", "props": {"note": "string:200?", "maxUses": "int:1:10000", "expiresAt": "ts?"}},
    "CreateRegistrationInviteResult": {"description": "新邀请码，明文只在此返回一次", "props": {"invite": "RegistrationInvite", "code": "string:64"}},
    "ListRegistrationInvitesResult": {"description": "注册邀请码列表", "props": {"invites": "[RegistrationInvite]"}},
    "RegistrationInviteResult": {"description": "单个邀请码", "props": {"invite": "RegistrationInvite"}},
    "UserSummary": {"description": "用户摘要", "props": {"userId": "id", "accountId": "id", "email": "string:320", "displayName": "string:100", "status": "enum:active|disabled|deleted", "siteCount": "int:0", "createdAt": "ts"}},
    "ListUsersResult": {"description": "用户列表", "props": {"users": "[UserSummary]", "nextCursor": "string:512?"}},
    "SetUserStatusInput": {"description": "停用或恢复用户", "props": {"status": "enum:active|disabled"}},
    "UserResult": {"description": "单个用户", "props": {"user": "UserSummary"}},
    "AdminSite": {"description": "站主视角的站点", "props": {"siteId": "id", "slug": "string:63", "name": "string:100", "ownerUserId": "id", "ownerEmail": "string:320", "status": "enum:active|suspended|deleted", "createdAt": "ts"}},
    "ListAllSitesResult": {"description": "全部站点", "props": {"sites": "[AdminSite]", "nextCursor": "string:512?"}},
    "SetSiteStatusInput": {"description": "下架或恢复站点", "props": {"status": "enum:active|suspended", "reason": "string:500?"}},
    "AdminSiteResult": {"description": "单个站点", "props": {"site": "AdminSite"}},
    "SubmitReportInput": {"description": "访客举报站点", "props": {"host": "string:253:3", "url": "string:1024?", "reason": "enum:spam|phishing|illegal|copyright|other", "detail": "string:2000?", "contact": "string:320?"}},
    "SubmitReportResult": {"description": "举报已受理", "props": {"reportId": "id"}},
    "Report": {"description": "举报记录", "props": {"reportId": "id", "siteId": "id", "host": "string:253", "url": "string:1024", "reason": "enum:spam|phishing|illegal|copyright|other", "detail": "string:2000", "status": "enum:open|dismissed|takedown|banned", "resolution": "string:500", "createdAt": "ts"}},
    "ListReportsResult": {"description": "举报列表", "props": {"reports": "[Report]"}},
    "ResolveReportInput": {"description": "处理举报", "props": {"action": "enum:dismiss|takedown|ban_owner", "note": "string:500?"}},
    "ReportResult": {"description": "单个举报", "props": {"report": "Report"}},
    "AiInvite": {"description": "AI 邀请码（只存摘要）：兑换后给用户平台 AI 额度", "props": {"inviteId": "id", "note": "string:200", "capMicros": "int:0", "period": "enum:once|monthly", "tasks": "[string:64]", "maxUses": "int:1", "used": "int:0", "maxSites": "int:0?", "storageBytes": "int:0?", "expiresAt": "ts?", "revoked": "bool", "createdAt": "ts"}},
    "CreateAiInviteInput": {"description": "站主生成 AI 邀请码：花费上限（USD micros）、周期、可用任务、有效期与次数，以及随码带的站点数/存储额度", "props": {"note": "string:200?", "capMicros": "int:0", "period": "enum:once|monthly", "tasks": "[string:64]?", "maxUses": "int:1:10000", "maxSites": "int:0:1000?", "storageBytes": "int:0?", "expiresAt": "ts?"}},
    "CreateAiInviteResult": {"description": "新码只在创建时返回一次", "props": {"code": "string:64", "invite": "AiInvite"}},
    "ListAiInvitesResult": {"description": "AI 邀请码列表", "props": {"invites": "[AiInvite]"}},
    "AiInviteResult": {"description": "单个 AI 邀请码", "props": {"invite": "AiInvite"}},
    "RedeemAiCodeInput": {"description": "用户兑换 AI 邀请码；新码替换旧码，旧码剩余额度作废", "props": {"code": "string:64:1"}},
    "MyAi": {"description": "当前用户的平台 AI 权益（已用额度在 model-gateway 的 /v1/ai/usage）", "props": {"entitled": "bool", "capMicros": "int:0", "period": "enum:once|monthly?", "tasks": "[string:64]", "redeemedAt": "ts?", "periodStart": "ts?"}},
    "MyAiResult": {"description": "当前用户的平台 AI 权益", "props": {"ai": "MyAi"}},
    "SiteAiPolicy": {"description": "站点的 AI 策略：谁付费、额度、哪些任务可用平台渠道、访客每日提问上限；只给 model-gateway 与 qa", "props": {"siteId": "id", "ownerUserId": "id", "platformOwner": "bool", "platformAllowed": "bool", "capMicros": "int:0", "periodStartNs": "int:0", "tasks": "[string:64]", "siteIds": "[id]", "visitorQaDaily": "int:0"}},
    "StartDriveAuthInput": {"description": "为备份目标发起网盘授权", "props": {"provider": "enum:gdrive|onedrive|dropbox", "targetId": "id", "redirectUri": "string:512:1"}},
    "StartDriveAuthResult": {"description": "网盘授权跳转地址", "props": {"authorizeUrl": "string:2048"}},
    "CompleteDriveAuthInput": {"description": "网盘授权回调：用授权码换长期授权并交给内容域保存", "props": {"code": "string:2048:1", "state": "string:256:1", "redirectUri": "string:512:1"}},
    "RefreshDriveTokenInput": {"description": "内容域用保存的长期授权换短期访问令牌", "props": {"provider": "enum:gdrive|onedrive|dropbox", "refreshToken": "string:4096:1"}},
    "RefreshDriveTokenResult": {"description": "短期访问令牌；服务商换发了新的长期授权时一并带回", "props": {"accessToken": "string:4096", "refreshToken": "string:4096?"}},
    "OkResult": {"description": "无返回内容的确认", "props": {"ok": "bool"}},
    "PrivateAccessResult": {"description": "协作者进入私有站点用的一次性码（60 秒内有效）与站点主地址", "props": {"code": "string:128", "host": "string:253"}},
    "RedeemPrivateAccessInput": {"description": "站点域名上的入口用一次性码换取站点专用短期访问", "props": {"code": "string:128:1"}},
    "PrivateAccessGrant": {"description": "换取成功后站点专用访问的有效秒数", "props": {"ttlSeconds": "int:1"}},
    "TlsHostResult": {"description": "入口 Caddy 按需签证书前问：这个域名是不是平台认可的（平台域名、已验证的站点域名）", "props": {"allowed": "bool"}}
  },
  "ops": [
    {"id": "readAuthOptions", "method": "get", "path": "/v1/auth/options", "perm": "anonymous", "summary": "读取登录页选项", "out": "ReadAuthOptionsResult"},
    {"id": "registerUser", "method": "post", "path": "/v1/users:register", "perm": "anonymous", "summary": "邮箱注册并登录", "in": "RegisterUserInput", "out": "RegisterUserResult"},
    {"id": "oauthStart", "method": "post", "path": "/v1/oauth/{provider}:start", "perm": "anonymous", "summary": "开始第三方登录", "path_params": ["provider"], "in": "OauthStartInput", "out": "OauthStartResult"},
    {"id": "oauthLogin", "method": "post", "path": "/v1/oauth/{provider}:login", "perm": "anonymous", "summary": "第三方登录回调", "path_params": ["provider"], "in": "OauthLoginInput", "out": "RegisterUserResult"},
    {"id": "listMySites", "method": "get", "path": "/v1/sites", "perm": "account.self", "summary": "列出我的站点", "out": "ListMySitesResult"},
    {"id": "createSite", "method": "post", "path": "/v1/sites", "perm": "account.self", "summary": "创建站点", "in": "CreateSiteInput", "out": "SiteResult"},
    {"id": "readSite", "method": "get", "path": "/v1/sites/{siteId}", "perm": "site.read", "summary": "读取站点", "path_params": ["siteId"], "out": "SiteResult"},
    {"id": "updateSite", "method": "patch", "path": "/v1/sites/{siteId}", "perm": "site.manage", "summary": "修改站点", "path_params": ["siteId"], "in": "UpdateSiteInput", "out": "SiteResult"},
    {"id": "deleteSite", "method": "delete", "path": "/v1/sites/{siteId}", "perm": "account.manage", "summary": "删除站点", "path_params": ["siteId"], "out": "RemovedResult"},
    {"id": "listSiteMembers", "method": "get", "path": "/v1/sites/{siteId}/members", "perm": "account.manage", "summary": "列出站点成员", "path_params": ["siteId"], "out": "ListSiteMembersResult"},
    {"id": "addSiteMember", "method": "post", "path": "/v1/sites/{siteId}/members", "perm": "account.manage", "summary": "添加站点成员", "path_params": ["siteId"], "in": "AddSiteMemberInput", "out": "SiteMemberResult"},
    {"id": "updateSiteMember", "method": "put", "path": "/v1/sites/{siteId}/members/{userId}", "perm": "account.manage", "summary": "修改成员角色", "path_params": ["siteId", "userId"], "in": "UpdateSiteMemberInput", "out": "SiteMemberResult"},
    {"id": "removeSiteMember", "method": "delete", "path": "/v1/sites/{siteId}/members/{userId}", "perm": "account.manage", "summary": "移除站点成员", "path_params": ["siteId", "userId"], "out": "RemovedResult"},
    {"id": "listSiteDomains", "method": "get", "path": "/v1/sites/{siteId}/domains", "perm": "account.manage", "summary": "列出站点域名", "path_params": ["siteId"], "out": "ListSiteDomainsResult"},
    {"id": "addSiteDomain", "method": "post", "path": "/v1/sites/{siteId}/domains", "perm": "account.manage", "summary": "绑定自定义域名", "path_params": ["siteId"], "in": "AddSiteDomainInput", "out": "SiteDomainResult"},
    {"id": "verifySiteDomain", "method": "post", "path": "/v1/sites/{siteId}/domains/{host}:verify", "perm": "account.manage", "summary": "验证域名所有权", "path_params": ["siteId", "host"], "path_free": true, "out": "SiteDomainResult"},
    {"id": "setPrimaryDomain", "method": "post", "path": "/v1/sites/{siteId}/domains/{host}:primary", "perm": "account.manage", "summary": "设为主域名", "path_params": ["siteId", "host"], "path_free": true, "out": "SiteDomainResult"},
    {"id": "removeSiteDomain", "method": "delete", "path": "/v1/sites/{siteId}/domains/{host}", "perm": "account.manage", "summary": "解绑域名", "path_params": ["siteId", "host"], "path_free": true, "out": "RemovedResult"},
    {"id": "resolveHost", "method": "get", "path": "/v1/hosts/{host}", "perm": "service", "summary": "按域名解析站点", "path_params": ["host"], "path_free": true, "out": "ResolveHostResult"},
    {"id": "readPlatformSettings", "method": "get", "path": "/v1/platform/settings", "perm": "system.manage", "summary": "读取平台设置", "out": "PlatformSettings"},
    {"id": "updatePlatformSettings", "method": "put", "path": "/v1/platform/settings", "perm": "system.manage", "summary": "更新平台设置", "in": "UpdatePlatformSettingsInput", "out": "PlatformSettings"},
    {"id": "createRegistrationInvite", "method": "post", "path": "/v1/registration-invites", "perm": "system.manage", "summary": "生成注册邀请码", "in": "CreateRegistrationInviteInput", "out": "CreateRegistrationInviteResult"},
    {"id": "listRegistrationInvites", "method": "get", "path": "/v1/registration-invites", "perm": "system.manage", "summary": "列出注册邀请码", "out": "ListRegistrationInvitesResult"},
    {"id": "revokeRegistrationInvite", "method": "delete", "path": "/v1/registration-invites/{inviteId}", "perm": "system.manage", "summary": "作废注册邀请码", "path_params": ["inviteId"], "out": "RegistrationInviteResult"},
    {"id": "listUsers", "method": "get", "path": "/v1/users", "perm": "system.manage", "summary": "列出用户", "query": {"limit": "int:1:100?", "cursor": "string:512?"}, "out": "ListUsersResult"},
    {"id": "setUserStatus", "method": "put", "path": "/v1/users/{userId}/status", "perm": "system.manage", "summary": "停用或恢复用户", "path_params": ["userId"], "in": "SetUserStatusInput", "out": "UserResult"},
    {"id": "listAllSites", "method": "get", "path": "/v1/admin/sites", "perm": "system.manage", "summary": "列出全部站点", "query": {"limit": "int:1:100?", "cursor": "string:512?"}, "out": "ListAllSitesResult"},
    {"id": "setSiteStatus", "method": "put", "path": "/v1/admin/sites/{siteId}/status", "perm": "system.manage", "summary": "下架或恢复站点", "path_params": ["siteId"], "in": "SetSiteStatusInput", "out": "AdminSiteResult"},
    {"id": "submitReport", "method": "post", "path": "/v1/reports", "perm": "anonymous", "summary": "访客举报站点", "in": "SubmitReportInput", "out": "SubmitReportResult"},
    {"id": "listReports", "method": "get", "path": "/v1/reports", "perm": "system.manage", "summary": "列出举报", "out": "ListReportsResult"},
    {"id": "resolveReport", "method": "post", "path": "/v1/reports/{reportId}:resolve", "perm": "system.manage", "summary": "处理举报", "path_params": ["reportId"], "in": "ResolveReportInput", "out": "ReportResult"},
    {"id": "createAiInvite", "method": "post", "path": "/v1/ai-invites", "perm": "system.manage", "summary": "生成 AI 邀请码", "in": "CreateAiInviteInput", "out": "CreateAiInviteResult"},
    {"id": "listAiInvites", "method": "get", "path": "/v1/ai-invites", "perm": "system.manage", "summary": "列出 AI 邀请码", "out": "ListAiInvitesResult"},
    {"id": "revokeAiInvite", "method": "delete", "path": "/v1/ai-invites/{inviteId}", "perm": "system.manage", "summary": "作废 AI 邀请码", "path_params": ["inviteId"], "out": "AiInviteResult"},
    {"id": "redeemAiCode", "method": "post", "path": "/v1/me/ai:redeem", "perm": "account.self", "summary": "兑换 AI 邀请码", "in": "RedeemAiCodeInput", "out": "MyAiResult"},
    {"id": "readMyAi", "method": "get", "path": "/v1/me/ai", "perm": "account.self", "summary": "读取自己的平台 AI 权益", "out": "MyAiResult"},
    {"id": "readSiteAiPolicy", "method": "get", "path": "/v1/sites/{siteId}/ai-policy", "perm": "service", "summary": "读取站点 AI 策略", "path_params": ["siteId"], "out": "SiteAiPolicy"},
    {"id": "issuePrivateAccess", "method": "post", "path": "/v1/sites/{siteId}/private-access", "perm": "site.read", "summary": "取得进入私有站点的一次性码", "path_params": ["siteId"], "out": "PrivateAccessResult"},
    {"id": "redeemPrivateAccess", "method": "post", "path": "/v1/sites/{siteId}/private-access:redeem", "perm": "service", "summary": "站点域名入口兑换一次性码", "path_params": ["siteId"], "in": "RedeemPrivateAccessInput", "out": "PrivateAccessGrant"},
    {"id": "allowTlsHost", "method": "get", "path": "/v1/tls/hosts/{host}", "perm": "service", "summary": "域名是否可以签发证书", "path_params": ["host"], "out": "TlsHostResult"},
    {"id": "startDriveAuth", "method": "post", "path": "/v1/sites/{siteId}/drive-auth/start", "perm": "backup.manage", "summary": "为备份目标发起网盘授权", "path_params": ["siteId"], "in": "StartDriveAuthInput", "out": "StartDriveAuthResult"},
    {"id": "completeDriveAuth", "method": "post", "path": "/v1/sites/{siteId}/drive-auth/complete", "perm": "backup.manage", "summary": "完成网盘授权", "path_params": ["siteId"], "in": "CompleteDriveAuthInput", "out": "OkResult"},
    {"id": "refreshDriveToken", "method": "post", "path": "/v1/drive-tokens:refresh", "perm": "service", "summary": "内容域换取网盘短期访问令牌", "in": "RefreshDriveTokenInput", "out": "RefreshDriveTokenResult"},
    {"id": "noteVisitorQaCap", "method": "post", "path": "/v1/sites/{siteId}/visitor-qa-cap", "perm": "service", "summary": "记录站点当天访客提问已达上限", "path_params": ["siteId"], "out": "OkResult"}
  ]
}
