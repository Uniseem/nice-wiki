# identity 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10002 identity && mkdir -p /data/identity && chown 10002:10002 /data/identity
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/identity /usr/local/bin/identity
USER 10002:10002
EXPOSE 8101
VOLUME ["/data/identity"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/identity"]
CMD ["--config", "/config/identity.json"]
