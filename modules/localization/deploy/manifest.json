{
  "slug": "localization",
  "image": "nice-wiki-localization",
  "command": ["/localization", "--config", "/config/service.config.json"],
  "httpPort": 8108,
  "dataVolume": "/data/localization",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "localization-signing-key",
      "path": "/run/secrets/localization-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    },
    {
      "module": "content",
      "endpoint": "http://content:8103",
      "env": "NW_DEP_CONTENT"
    },
    {
      "module": "model-gateway",
      "endpoint": "http://model-gateway:8105",
      "env": "NW_DEP_MODEL_GATEWAY"
    },
    {
      "module": "memory",
      "endpoint": "http://memory:8109",
      "env": "NW_DEP_MEMORY"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    },
    {
      "module": "data-protection",
      "endpoint": "http://data-protection:8113",
      "env": "NW_DEP_DATA_PROTECTION"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
