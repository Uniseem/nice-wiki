# localization 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10009 localization && mkdir -p /data/localization && chown 10009:10009 /data/localization
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/localization /usr/local/bin/localization
USER 10009:10009
EXPOSE 8108
VOLUME ["/data/localization"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/localization"]
CMD ["--config", "/config/localization.json"]
