# model-gateway 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10006 model-gateway && mkdir -p /data/model-gateway && chown 10006:10006 /data/model-gateway
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/model-gateway /usr/local/bin/model-gateway
USER 10006:10006
EXPOSE 8105
VOLUME ["/data/model-gateway"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/model-gateway"]
CMD ["--config", "/config/model-gateway.json"]
