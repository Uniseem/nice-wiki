  "jobTypes": [],
  "backgroundTasks": [
    {
      "function": "content.RecoverPreparedCommits",
      "schedule": "启动时（入口开放前）",
      "purpose": "恢复崩溃前正文提交日志"
    },
    {
      "function": "content.ExpireIdleLocks",
      "schedule": "每30秒",
      "purpose": "释放失联或提示后仍空闲锁"
    },
    {
      "function": "content.RelayOutbox",
      "schedule": "启动后持续，空闲每1秒",
      "purpose": "把已提交的outbox事件可靠转交jobs；进程启动先补发，之后后台循环"
    }
  ],
