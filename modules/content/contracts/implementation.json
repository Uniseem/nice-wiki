{
  "moduleId": "M04",
  "module": "content",
  "version": 1,
  "phase": "design",
  "requirements": [
    {
      "id": "M04-R01",
      "description": "完整Tiptap块与行内产品",
      "acceptance": "16类块所有attrs完整、稳定ID；H2-H4不折叠、8项行内、多栏2–4不可嵌套、画板3文件、统一4平台视频"
    },
    {
      "id": "M04-R02",
      "description": "共享自动保存与内存锁",
      "acceptance": "同篇一共享draft；他人只读；30秒心跳/2min失联/15min无输入提醒/再2min释放；同人双tab版本冲突"
    },
    {
      "id": "M04-R03",
      "description": "发布草稿隔离与撤回",
      "acceptance": "只有点击发布精确稿公开；撤回变draft，公开失效且旧事件不复活"
    },
    {
      "id": "M04-R04",
      "description": "可读路由及301/410",
      "acceptance": "首发英文slug人工优先/AI可选，所有语言共用；移动父节点全部后代旧URL301；删除410或选择替代跳转"
    },
    {
      "id": "M04-R05",
      "description": "历史署名回滚与回收站",
      "acceptance": "每发布git镜像、作者执行账号；对比/回滚新发布；超管才永久清空；已删账号署名保留"
    },
    {
      "id": "M04-R06",
      "description": "文件真相和持久日志",
      "acceptance": "PREPARED不公开，COMMITTED缺正文隔离，CAS/fence双检无覆盖；schema逐级迁移"
    },
    {
      "id": "M04-R07",
      "description": "D55无AI基础编辑预览发布",
      "acceptance": "缺渠道不阻塞初始化/编辑/管理员预览；人工英文slug/SEO支持无模型发布，不制造假调用结果"
    },
    {
      "id": "M04-R08",
      "description": "粘贴编辑交互与明确排除",
      "acceptance": "Word/网页/Markdown粘贴转换、拖图文件上传、slash/BubbleMenu/Markdown规则；不导入、不块引用/图谱/实时协作"
    },
    {
      "id": "M04-R901",
      "description": "本域独立Go module、main入口、完整依赖装配、HTTP/worker生命周期、镜像/manifest及既有UI独立构建；健康和就绪不调用模型。",
      "acceptance": "未来分别从本域目录构建/启动，验证所有登记handler均装配、Health/Ready语义及安全关闭；当前未实现、未执行。"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "mode": "sync",
      "purpose": "全站功能权限与即时撤销，唯一超管强释/purge",
      "failurePolicy": "未知权限关闭写入"
    },
    {
      "module": "site-config",
      "mode": "sync",
      "purpose": "基准语言/限制和runtime epoch",
      "failurePolicy": "新写关闭，无AI不影响基础功能"
    },
    {
      "module": "media",
      "mode": "sync",
      "purpose": "不可变资源ready/当前历史引用/pin",
      "failurePolicy": "未知当前引用禁止提交，已手清历史缺失明确提示"
    },
    {
      "module": "model-gateway",
      "mode": "optional",
      "purpose": "content.slug/content.seo首发元数据生成",
      "failurePolicy": "人工优先；无渠道提示人工补slug/SEO，不假模型fallback"
    },
    {
      "module": "jobs",
      "mode": "event",
      "purpose": "发布render/index/translation/git镜像和审计",
      "failurePolicy": "原子outbox保留，公开权威立即更新"
    }
  ],
