{
  "slug": "content",
  "image": "nice-wiki-content",
  "command": ["/content", "--config", "/config/service.defaults.json"],
  "httpPort": 8103,
  "dataVolume": "/data/content",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "content-signing-key",
      "path": "/run/secrets/content-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    },
    {
      "module": "media",
      "endpoint": "http://media:8104",
      "env": "NW_DEP_MEDIA"
    },
    {
      "module": "model-gateway",
      "endpoint": "http://model-gateway:8105",
      "env": "NW_DEP_MODEL_GATEWAY"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
