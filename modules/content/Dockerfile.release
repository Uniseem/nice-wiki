# content 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10004 content && mkdir -p /data/content && chown 10004:10004 /data/content
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/content /usr/local/bin/content
USER 10004:10004
EXPOSE 8103
VOLUME ["/data/content"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/content"]
CMD ["--config", "/config/content.json"]
