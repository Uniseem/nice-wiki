  "components": {
    "securitySchemes": {
      "serviceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT(EdDSA)",
        "description": "调用方服务用部署时登记的Ed25519私钥签发≤60秒断言（iss=调用服务、aud=本服务、method、path、bodyHash、jti）；接收方按trustAnchorRef服务公钥表验证并拒绝重放"
      },
      "userDelegation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Portal-Proof",
        "description": "portal为当前请求签发的≤10秒用户委托证明（actor、grants、sessionVersion、route、bodyHash）；下游链路原样传递，接收方仍经identity:checkAuthorization核权限与会话版本"
      },
      "visitorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nw_visitor",
        "description": "traffic-guard签署的伪名访客会话；只用于公开问答与语言偏好，不含IP"
      },
      "admissionPermit": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admission-Permit",
        "description": "portal为公开AI请求向traffic-guard申请的准入许可；问答服务消费，网关本地验签"
      }
    },
    "schemas": {
      "QueueSiteConfigResult": {
        "$ref": "../../site-config/contracts/types.json#/$defs/ReadSiteConfigResult"
      },
      "KnowledgeOwnerRecoveryResult": {
        "$ref": "../../../contracts/common.schema.json#/$defs/OwnerRecoveryResult"
      },
      "ReadInitializationStatusResult": {
        "$ref": "../../site-config/contracts/types.json#/$defs/ReadInitializationStatusResult"
      }
    }
  },
  "x-runtime-payload-schemas": [
    "QueueSiteConfigResult",
    "KnowledgeOwnerRecoveryResult",
    "ReadInitializationStatusResult"
  ]
}
