{
  "openapi": "3.1.0",
  "info": {
    "title": "jobs HTTP 合同",
    "version": "1.0.0",
    "description": "设计合同；未实现或运行真实接口。服务间HTTP/JSON/SSE，无共享数据库。"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "http://jobs:8080"
    }
  ],
  "paths": {
    "/v1/jobs": {
      "post": {
        "operationId": "createJob",
        "summary": "持久提交任务",
        "description": "提交不可变引用与owner/type，202 AcceptedJob，epoch必须当前 可选notBefore指定最早领取时刻，省略保留原立即入队语义；显式值是去重材料，执行期限由owner领取时建立，不沿用创建RPC截止。",
        "x-handler": "jobs.CreateJob",
        "x-permission": "service",
        "x-data-epoch-required": true,
        "responses": {
          "202": {
            "description": "提交不可变引用与owner/type，202 AcceptedJob，epoch必须当前",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/CreateJobResult"
                }
              }
            }
          },
          "409": {
            "description": "公共错误；CONFLICT",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.json#/$defs/CreateJobRequestBody"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "缺省由入口生成；幂等写另使用Idempotency-Key绑定inputHash"
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "本操作幂等键，同键不同规范body hash返回409"
          }
        ],
        "security": [
          {
            "serviceAssertion": []
          }
        ]
      },
      "get": {
        "operationId": "listJobs",
        "summary": "查看任务队列",
        "description": "job.manage仅入口粗能力；按持久任务owner/type或事件producer/version目录经identity核当前具体业务管理权限，不返回任务输入正文或原事件payload。failed兼容筛选当前返回空；active包含orphan供观察，orphan不可人工retry。",
        "x-handler": "jobs.ListJobs",
        "x-permission": "job.manage",
        "responses": {
          "200": {
            "description": "查看任务队列成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/ListJobsResult"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN：权限不足",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "409": {
            "description": "CONFLICT / VERSION_MISMATCH",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "422": {
            "description": "INTEGRITY_ERROR",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "423": {
            "description": "LOCKED：维护或安全点暂停新的管理写入",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "failed",
                "dead-letter",
                "all"
              ],
              "default": "active"
            },
            "description": "状态"
          },
          {
            "in": "query",
            "name": "owner",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "owner"
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "上一页返回的签名游标"
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "每页条数"
          }
        ],
        "security": [
          {
            "serviceAssertion": [],
            "userDelegation": []
          }
        ]
      }
    },
