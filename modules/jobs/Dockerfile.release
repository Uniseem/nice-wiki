# jobs 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10012 jobs && mkdir -p /data/jobs && chown 10012:10012 /data/jobs
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/jobs /usr/local/bin/jobs
USER 10012:10012
EXPOSE 8111
VOLUME ["/data/jobs"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/jobs"]
CMD ["--config", "/config/jobs.json"]
