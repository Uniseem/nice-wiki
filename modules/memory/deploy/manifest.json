{
  "slug": "memory",
  "image": "nice-wiki-memory",
  "command": ["/memory", "--config", "/config/service.config.json"],
  "httpPort": 8109,
  "dataVolume": "/data/memory",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "memory-signing-key",
      "path": "/run/secrets/memory-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "model-gateway",
      "endpoint": "http://model-gateway:8105",
      "env": "NW_DEP_MODEL_GATEWAY"
    },
    {
      "module": "localization",
      "endpoint": "http://localization:8108",
      "env": "NW_DEP_LOCALIZATION"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
