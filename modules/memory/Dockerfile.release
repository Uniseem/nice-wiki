# memory 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10010 memory && mkdir -p /data/memory && chown 10010:10010 /data/memory
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/memory /usr/local/bin/memory
USER 10010:10010
EXPOSE 8109
VOLUME ["/data/memory"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/memory"]
CMD ["--config", "/config/memory.json"]
