{
  "module": "media",
  "version": 1,
  "events": [
    {
      "name": "media.asset.changed",
      "version": 1,
      "direction": "publish",
      "payloadSchema": {
        "$ref": "types.json#/$defs/AssetChangedPayload"
      },
      "purpose": "ready/deleted资源元数据失效与统计",
      "delivery": "at-least-once",
      "ordering": "assetId version/refGeneration单调",
      "idempotency": "eventId去重"
    },
    {
      "name": "content.resources.changed",
      "version": 2,
      "direction": "consume",
      "payloadSchema": {
        "$ref": "../../content/contracts/types.json#/$defs/ResourceReferencesChangedPayloadV2"
      },
      "purpose": "消费content提交后发出的完整pin材料，更新当前/历史refs，不以迟到事件替代最终权威检查",
      "delivery": "at-least-once",
      "ordering": "sourceVersion单调，低版只确认；subject/revision来自jobs信封",
      "idempotency": "jobs信封eventId+payloadHash去重，sourceVersion单调",
      "handler": "media.ApplyReferenceEvent"
    },
    {
      "name": "identity.site.changed",
      "version": 1,
      "direction": "consume",
      "payloadSchema": {
        "$ref": "../../identity/contracts/types.json#/$defs/SiteChangedPayload"
      },
      "purpose": "记下站点状态：后台循环只处理正常站点",
      "delivery": "at-least-once",
      "ordering": "按站点 revision 单调，只接受更高版本",
      "idempotency": "按 revision 覆盖；清除可重复执行",
      "handler": "sitestate.RecordSite"
    },
    {
      "name": "identity.site.purged",
      "version": 1,
      "direction": "consume",
      "payloadSchema": {
        "$ref": "../../identity/contracts/types.json#/$defs/SitePurgedPayload"
      },
      "purpose": "删掉本域里该站点的全部数据和文件",
      "delivery": "at-least-once",
      "ordering": "按站点 revision 单调，只接受更高版本",
      "idempotency": "按 revision 覆盖；清除可重复执行",
      "handler": "sitestate.PurgeSite"
    }
  ]
}
