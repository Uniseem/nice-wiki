{
  "slug": "media",
  "image": "nice-wiki-media",
  "command": ["/media", "--config", "/config/service.defaults.json"],
  "httpPort": 8104,
  "dataVolume": "/data/media",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "media-signing-key",
      "path": "/run/secrets/media-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    },
    {
      "module": "content",
      "endpoint": "http://content:8103",
      "env": "NW_DEP_CONTENT"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
