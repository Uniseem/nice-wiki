# public-site 发布镜像：直接打包发版流程已编译好的二进制（release/linux-<架构>/），不在镜像里再编译。
# 构建上下文为仓库根，由 .github/workflows/release.yml 按 amd64/arm64 构建。由 scripts/gen_deploy.py 生成。
FROM alpine:3.20
RUN adduser -D -u 10001 public-site && mkdir -p /data/public-site && chown 10001:10001 /data/public-site
ARG TARGETARCH
COPY release/linux-${TARGETARCH}/public-site /usr/local/bin/public-site
USER 10001:10001
EXPOSE 8081
VOLUME ["/data/public-site"]
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/public-site"]
CMD ["--config", "/config/public-site.json"]
