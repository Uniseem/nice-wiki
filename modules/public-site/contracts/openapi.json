            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../../contracts/common.schema.json#/$defs/SnapshotCommitRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier",
              "description": "公共 Identifier 合同，遵守其字段和空值规则"
            },
            "description": "缺省由入口生成；幂等写另使用Idempotency-Key绑定inputHash"
