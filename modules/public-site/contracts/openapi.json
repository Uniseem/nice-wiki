    "/sitemap/{locale}/{shard}.xml": {
      "get": {
        "operationId": "handleSitemapShard",
        "summary": "单分片 sitemap",
        "description": "公开、规范、已发布地址和更新时间",
        "x-handler": "M06-F031",
        "x-permission": "anonymous",
        "x-data-epoch-required": true,
        "responses": {
          "200": {
            "description": "公开、规范、已发布地址和更新时间",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
