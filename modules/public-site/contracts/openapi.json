            },
            "description": "本操作幂等键，同键不同规范body hash返回409"
          }
        ],
        "security": [
          {
            "serviceAuth": []
          }
        ],
        "x-recovery-authorization": "maintenance下本地校验公共RecoveryAuthorization+本次独立control记录；普通运行需要service身份+superadmin委托"
      }
    },
    "/healthz": {
