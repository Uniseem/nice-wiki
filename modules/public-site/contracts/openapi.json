                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "locale",
            "required": true,
            "schema": {
              "type": "string",
              "description": "locale；UTF-8；不得为 null",
              "maxLength": 35,
              "minLength": 1,
              "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
            },
            "description": "路径值由HTTP绑定器填入函数Input，正文不得声明冲突值"
          },
          {
            "in": "path",
            "name": "shard",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807,
              "description": "shard 非负 int64；不用浮点数"
            },
            "description": "路径值由HTTP绑定器填入函数Input，正文不得声明冲突值"
          },
          {
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
