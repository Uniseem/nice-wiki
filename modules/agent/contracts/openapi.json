{
  "openapi": "3.1.0",
  "info": {
    "title": "M16 原生 Agent",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "summary": "进程存活",
        "x-handler": "agent.Health",
        "x-permission": "anonymous",
        "security": [],
        "responses": {
          "200": {
            "description": "进程存活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/HealthStatus"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "summary": "原生运行时就绪",
        "x-handler": "agent.Ready",
        "x-permission": "anonymous",
        "security": [],
        "responses": {
          "200": {
            "description": "原生运行时就绪",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/ServiceReadiness"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "startAgentRun",
        "summary": "启动独立原生会话",
        "x-handler": "agent.StartRun",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "responses": {
          "200": {
            "description": "启动独立原生会话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/AgentStarted"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.json#/$defs/AgentInput"
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/events": {
      "get": {
        "operationId": "readAgentEvents",
        "summary": "读取模型及工具请求",
        "x-handler": "agent.ReadEvents",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "responses": {
          "200": {
            "description": "读取模型及工具请求",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/AgentEvents"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
            }
          },
          {
            "name": "afterSequence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ]
      }
    },
    "/v1/runs/{runId}/replies/{requestId}": {
      "post": {
        "operationId": "replyAgentRequest",
        "summary": "提交模型或工具结果",
        "x-handler": "agent.Reply",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "responses": {
          "200": {
            "description": "提交模型或工具结果",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/AgentAccepted"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
            }
          },
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.json#/$defs/AgentReply"
              }
            }
          }
        }
      }
    },
    "/v1/runs/{runId}/cancel": {
      "post": {
        "operationId": "cancelAgentRun",
        "summary": "取消并释放会话",
        "x-handler": "agent.Cancel",
        "x-permission": "service",
        "security": [
          {
            "serviceAssertion": []
          }
        ],
        "responses": {
          "200": {
            "description": "取消并释放会话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./types.json#/$defs/AgentCancelled"
                }
              }
            }
          },
          "default": {
            "description": "公共错误",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "../../../contracts/common.schema.json#/$defs/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./types.json#/$defs/AgentEmpty"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceAssertion": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT(EdDSA)",
        "description": "调用方服务用部署时登记的Ed25519私钥签发≤60秒断言（iss=调用服务、aud=本服务、method、path、bodyHash、jti）；接收方按trustAnchorRef服务公钥表验证并拒绝重放"
      }
    }
  }
}
