{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nice-wiki.example/contracts/agent/types.json",
  "$defs": {
    "AgentModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "providerId",
        "modelId",
        "contextWindow",
        "maxOutputTokens"
      ]
    },
    "AgentInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/AgentModel"
        },
        "language": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../model-gateway/contracts/types.json#/$defs/GatewayMessage"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "../../model-gateway/contracts/types.json#/$defs/GatewayTool"
          }
        },
        "turnStart": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "language",
        "messages",
        "tools",
        "turnStart"
      ]
    },
    "AgentStarted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Identifier"
        }
      },
      "required": [
        "runId"
      ]
    },
    "AgentFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "invoke",
            "tool",
            "event",
            "done",
            "failed"
          ]
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "kind",
        "payload"
      ]
    },
    "AgentEvents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentFrame"
          }
        },
        "done": {
          "type": "boolean"
        }
      },
      "required": [
        "frames",
        "done"
      ]
    },
    "AgentReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "type": "string"
        }
      },
      "required": [
        "payload"
      ]
    },
    "AgentAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted"
      ]
    },
    "AgentCancelled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancelled": {
          "type": "boolean"
        }
      },
      "required": [
        "cancelled"
      ]
    },
    "AgentEmpty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "ServiceReadiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": {
          "$ref": "../../../contracts/common.schema.json#/$defs/HealthStatus"
        },
        "activeDataEpoch": {
          "type": [
            "string",
            "null"
          ],
          "description": "未初始化null；恢复切换期间用于确认本域已换入的目标epoch"
        },
        "runtimeRevision": {
          "$ref": "../../../contracts/common.schema.json#/$defs/Revision"
        },
        "maintenance": {
          "type": "boolean",
          "description": "当前全站维护，公开读写仍被门禁阻止"
        },
        "publicRequestsAllowed": {
          "type": "boolean",
          "description": "维护时false；ready只表明本域安全可参与控制，不提前开放公开业务"
        },
        "initialized": {
          "type": "boolean",
          "description": "未初始化只能暴露已有初始化能力；AI配置缺项不改变基础能力就绪"
        },
        "journalRecovered": {
          "type": "boolean",
          "description": "journal完整恢复"
        },
        "safePoint": {
          "type": "boolean",
          "description": "恢复/备份协调实际安全点，不能仅等任务调度暂停"
        }
      },
      "required": [
        "health",
        "activeDataEpoch",
        "runtimeRevision",
        "maintenance",
        "publicRequestsAllowed",
        "initialized",
        "journalRecovered",
        "safePoint"
      ],
      "description": "就绪响应不含secret、服务端点、IP或问答正文"
    }
  }
}
