{
  "slug": "data-protection",
  "image": "nice-wiki-data-protection",
  "command": ["/data-protection", "--config", "/config/defaults.json", "--listen", "0.0.0.0:8113"],
  "httpPort": 8113,
  "dataVolume": "/data/data-protection",
  "secrets": [
    {
      "name": "trust-anchors",
      "path": "/run/secrets/trust-anchors.json"
    },
    {
      "name": "data-protection-signing-key",
      "path": "/run/secrets/data-protection-signing-key.json"
    }
  ],
  "dependencies": [
    {
      "module": "identity",
      "endpoint": "http://identity:8101",
      "env": "NW_DEP_IDENTITY"
    },
    {
      "module": "site-config",
      "endpoint": "http://site-config:8102",
      "env": "NW_DEP_SITE_CONFIG"
    },
    {
      "module": "content",
      "endpoint": "http://content:8103",
      "env": "NW_DEP_CONTENT"
    },
    {
      "module": "media",
      "endpoint": "http://media:8104",
      "env": "NW_DEP_MEDIA"
    },
    {
      "module": "public-site",
      "endpoint": "http://public-site:8081",
      "env": "NW_DEP_PUBLIC_SITE"
    },
    {
      "module": "model-gateway",
      "endpoint": "http://model-gateway:8105",
      "env": "NW_DEP_MODEL_GATEWAY"
    },
    {
      "module": "knowledge",
      "endpoint": "http://knowledge:8106",
      "env": "NW_DEP_KNOWLEDGE"
    },
    {
      "module": "qa",
      "endpoint": "http://qa:8107",
      "env": "NW_DEP_QA"
    },
    {
      "module": "localization",
      "endpoint": "http://localization:8108",
      "env": "NW_DEP_LOCALIZATION"
    },
    {
      "module": "memory",
      "endpoint": "http://memory:8109",
      "env": "NW_DEP_MEMORY"
    },
    {
      "module": "traffic-guard",
      "endpoint": "http://traffic-guard:8110",
      "env": "NW_DEP_TRAFFIC_GUARD"
    },
    {
      "module": "jobs",
      "endpoint": "http://jobs:8111",
      "env": "NW_DEP_JOBS"
    },
    {
      "module": "analytics",
      "endpoint": "http://analytics:8112",
      "env": "NW_DEP_ANALYTICS"
    }
  ],
  "probes": {
    "healthz": "/healthz",
    "readyz": "/readyz"
  }
}
